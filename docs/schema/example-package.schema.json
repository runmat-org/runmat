{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "host_note": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "items": {
              "enum": [
                "open_source",
                "download"
              ]
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "snapshot": {
            "type": "boolean"
          },
          "source_sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "string",
                  "minLength": 1
                },
                "end": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "title",
                "start",
                "end"
              ]
            }
          },
          "model_illustration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "path",
              "alt",
              "caption",
              "width",
              "height"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "entry",
          "files",
          "expected_outputs",
          "host_note",
          "actions",
          "requirements"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "examples"
  ]
}
