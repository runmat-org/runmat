{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "host_note": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "items": {
              "enum": [
                "open_source",
                "download"
              ]
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "snapshot": {
            "type": "boolean"
          },
          "source_sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "string",
                  "minLength": 1
                },
                "end": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "title",
                "start",
                "end"
              ]
            }
          },
          "model_illustration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "path",
              "alt",
              "caption",
              "width",
              "height"
            ]
          },
          "receipts": {
            "type": "array",
            "description": "Run-derived values that docs quote, linked from prose as [value unit](receipt:<example id>#<receipt id>) (METHOD §2.7). The lint checks the prose value against `value` at the precision written.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "quantity",
                "value",
                "unit",
                "mesh",
                "run"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "quantity": {
                  "type": "string",
                  "minLength": 3,
                  "description": "What was measured and where, e.g. nodal von Mises stress on the top surface at x = 100 mm."
                },
                "output": {
                  "type": "string",
                  "description": "The study output that publishes the value, when it has one."
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "mesh": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "order",
                    "target_size"
                  ],
                  "properties": {
                    "order": {
                      "enum": [
                        "linear",
                        "quadratic"
                      ]
                    },
                    "target_size": {
                      "type": "string"
                    },
                    "nodes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "elements": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "reference": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "unit",
                    "source"
                  ],
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string",
                      "minLength": 3
                    }
                  }
                },
                "run": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cli",
                    "commit",
                    "date"
                  ],
                  "properties": {
                    "cli": {
                      "type": "string",
                      "description": "Release CLI binary name."
                    },
                    "commit": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{7,40}$"
                    },
                    "date": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "study": {
                      "type": "string",
                      "description": "Study file run, when it differs from the example entry (for example a mesh variant)."
                    },
                    "result": {
                      "type": "string",
                      "description": "Result digest or receipt path."
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "entry",
          "files",
          "expected_outputs",
          "host_note",
          "actions",
          "requirements"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "examples"
  ]
}
