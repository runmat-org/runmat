{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "pattern": "^/docs/simulation/"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "narrative": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "related_topics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "href": {
                  "type": "string",
                  "pattern": "^/docs/"
                }
              },
              "required": [
                "title",
                "href"
              ]
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "procedure": {
                "type": "string",
                "minLength": 1
              },
              "example_mesh": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "procedure",
              "example_mesh"
            ]
          },
          "verification_labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "route",
          "title",
          "summary",
          "keywords",
          "group",
          "order",
          "narrative",
          "examples",
          "related_topics",
          "scope",
          "verification_labels"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "topics"
  ]
}
