// Static strength of the demo wall-hook bracket (40 x 50 x 35 mm, steel).
// The two-kilonewton load presses down on the top face; the countersunk mounting holes are held.
geometry bracket {
    file = "./geometry/bracket.step"
    units = mm
    region body : solid { select name "WallHook_30mm"; expect exactly_one }
    region top_face : face { select name "Top face"; expect exactly_one }
    region mounting_holes : face { select name "Mounting holes"; expect one_or_more }
    region corner_fillets : face { select name "Corner fillets"; expect one_or_more }
}

mesh bracket on geometry.bracket {
    tetrahedra {
        order = quadratic
        target_size = 10 mm
        maximum_deviation = 0.1 mm
    }
}

material steel {
    mass_density = 7850 kg/m^3
    elastic {
        youngs_modulus = 200 GPa
        poisson_ratio = 0.3
    }
}

model loaded_bracket {
    assign material.steel to geometry.bracket.region.body
    constraint mounting {
        structural.fixed { target = geometry.bracket.region.mounting_holes }
    }
    load hanging_load {
        force on geometry.bracket.region.top_face = [0, 0, -2] kN
    }
    load_case service { include load.hanging_load }
}

study bracket_strength {
    geometry = geometry.bracket
    mesh = mesh.bracket
    model = model.loaded_bracket
    analysis static { structural static {} }
    output displacement = analysis.static.field.node.displacement
    output von_mises = analysis.static.field.element.von_mises_stress
    // The clamped countersink edges are stress singularities, so no body-wide stress peak is
    // reported. The corner fillets lie away from the supports and converge under refinement.
    output fillet_stress = mean(analysis.static.field.element.von_mises_stress, over = geometry.bracket.region.corner_fillets)
    output fillet_peak_stress = max(analysis.static.field.element.von_mises_stress, over = geometry.bracket.region.corner_fillets)
    output support_reaction = resultant(analysis.static.field.node.reaction_force, over = geometry.bracket.region.mounting_holes)
    output peak_displacement = max(magnitude(analysis.static.field.node.displacement), over = geometry.bracket.region.body)
}
