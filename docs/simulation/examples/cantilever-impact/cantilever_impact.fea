import function impactPulse from "./impactPulse.m"

geometry beam {
    file = "./geometry/cantilever.step"
    units = mm
    region body : solid { select name "Beam"; expect exactly_one }
    region fixed_end : face { select name "Fixed end"; expect exactly_one }
    region loaded_end : face { select name "Loaded end"; expect exactly_one }
}

mesh beam on geometry.beam {
    tetrahedra {
        order = quadratic
        target_size = 0.15 m
        maximum_deviation = 0.001 m
    }
}

material steel {
    mass_density = 7850 kg/m^3
    elastic {
        youngs_modulus = 200 GPa
        poisson_ratio = 0.3
    }
}

model struck_beam {
    assign material.steel to geometry.beam.region.body
    constraint fixed_end {
        structural.fixed { target = geometry.beam.region.fixed_end }
    }
    signal pulse : force over time {
        generated by function.impactPulse {
            arguments {
                peak = 1 kN
                duration = 6 ms
            }
            sample from 0 s to 50 ms at 20 kHz
            interpolation = linear
            extrapolation = reject
            tolerance = 1e-5 N
        }
    }
    excitation impact {
        force {
            target = geometry.beam.region.loaded_end
            signal = signal.pulse
            direction = global([0, 0, -1])
        }
    }
    load_case impact { include excitation.impact }
}

study cantilever_impact {
    geometry = geometry.beam
    mesh = mesh.beam
    model = model.struck_beam
    analysis response {
        structural transient {
            start_time = 0 s
            end_time = 50 ms
            time_step = 0.1 ms
        }
    }
    output displacement = analysis.response.field.node.displacement
}
