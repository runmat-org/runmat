version: 1
kind: study
id: modal_response_spectrum_experimental

geometry:
  path: ../../../crates/runmat-geometry/io/tests/fixtures/box.brep
  units: meter

model:
  source:
    inline:
      materials:
        steel:
          name: Structural steel
          mechanical:
            youngs_modulus_pa: 200000000000.0
            poisson_ratio: 0.3
            density_kg_per_m3: 7850.0

      material_assignments:
        - target: { solid: { region: solid_000001 } }
          material: steel

      regions:
        fixed_face:
          selector: { id: face_000001 }

      constraints:
        - structural:
            constraint_id: fixed_support
            frame: global
            kind:
              fixed:
                target:
                  region_id: fixed_face
                  entity_dimension: face
                  expected_topology: boundary_face
                  cardinality: one_or_more

      response_spectra:
        - spectrum_id: design_spectrum
          abscissa:
            frequency_hertz: [5.0, 10.0, 20.0, 40.0]
          ordinates: [1.2, 2.5, 1.8, 0.7]
          damping: { ratio: 0.05 }
          response: absolute_acceleration
          envelope: maximax
          interpolation: linear_frequency
          extrapolation: hold_endpoint
          direction:
            frame: global
            vector: [1.0, 0.0, 0.0]
          modal_combination: complete_quadratic_combination
          directional_combination: srss
          truncation:
            minimum_cumulative_mass_ratio: 0.9
            correction: none
          rigid_response: disabled
          construction: authored_design
          evidence:
            sampling_adequacy_ratio: 0.95
            max_interpolation_error: 0.02
          provenance_digest: sha256:documented-design-spectrum

mesh:
  target_edge_length_m: 10.0
  maximum_chordal_deviation_m: 0.1
  maximum_elements: 10000
  deterministic_seed: 7

sequence:
  sequence_id: modal_sequence
  steps:
    - step_id: modes
      family: structural
      procedure: modal_extraction
      solution_space: direct
      independent_domain: { eigenvalue: { requested_count: 12 } }
      activations:
        - object: { constraint: fixed_support }
          lifecycle: activate
      state_inputs: []
      state_outputs:
        - state_id: modal_basis
          kind: modal_basis
          completeness: complete
          persistence: until_dependents_complete
      observations: []
      accuracy:
        accuracy_plan_id: modes.accuracy
        criteria:
          - criterion_id: algebraic_residual
            target: global_equilibrium
            contribution: algebraic
            tolerance: { relative: 1.0e-8 }
            evidence: residual_bound
            mandatory: true
        unavailable_evidence: mark_indeterminate_experimental
        exceeded_limit: fail
        equivalence: { relative_tolerance: 1.0e-10 }
        resources:
          maximum_refinement_cycles: 0
          maximum_solver_tightenings: 0
          maximum_samples: 1000000
          maximum_wall_time_milliseconds: 3600000
          maximum_resident_bytes: 8589934592
      restart: fresh
    - step_id: response_spectrum
      family: structural
      procedure: modal_response_spectrum
      solution_space: modal_reduced
      independent_domain:
        response_spectra: { spectrum_ids: [design_spectrum] }
      activations: []
      state_inputs:
        - input_id: modal_basis
          required_kind: modal_basis
          source:
            upstream: { producer_step: modes, state_id: modal_basis }
          use_as: modal_basis
          conflict: reject
      state_outputs:
        - state_id: response_envelope
          kind: structural_response_envelope
          completeness: complete
          persistence: until_dependents_complete
      observations: []
      accuracy:
        accuracy_plan_id: response_spectrum.accuracy
        criteria:
          - criterion_id: modal_mass_capture
            target: numerical_result
            contribution: modal_truncation
            tolerance: { relative: 0.1 }
            evidence: convergence_study
            mandatory: true
        unavailable_evidence: mark_indeterminate_experimental
        exceeded_limit: fail
        equivalence: { relative_tolerance: 1.0e-10 }
        resources:
          maximum_refinement_cycles: 0
          maximum_solver_tightenings: 0
          maximum_samples: 1000000
          maximum_wall_time_milliseconds: 3600000
          maximum_resident_bytes: 8589934592
      restart: fresh
  dependencies:
    - predecessor: modes
      successor: response_spectrum
      reason: state_transfer
  transitions:
    - transition_id: modal_to_response_spectrum
      producer_step: modes
      consumer_step: response_spectrum
      state_id: modal_basis
      method: reuse
      topology: require_identical
      reference: preserve
  branches: []

execution:
  - step: modes
    backend: cpu
    requirement: experimental
  - step: response_spectrum
    backend: cpu
    requirement: experimental
