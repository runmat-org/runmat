geometry bracket {
    file = "./geometry/box.brep"
    units = m

    region body : solid {
        select id "solid_000001"
        expect exactly_one
    }
    region support : face {
        select id "face_000001"
        expect exactly_one
    }
}

mesh bracket on geometry.bracket {
    tetrahedra {
        order = linear
        target_size = 0.75 m
        maximum_deviation = 0.05 m
    }
}

material steel {
    mass_density = 7850 kg/m^3
    elastic {
        youngs_modulus = 200 GPa
        poisson_ratio = 0.3
    }
}

model random_environment {
    assign material.steel to geometry.bracket.region.body
    constraint fixed_support {
        structural.fixed { target = geometry.bracket.region.support }
    }
    random_excitation base_motion {
        frequencies = [0.1, 100, 1000, 10000, 100000] Hz
        channels = [
            { id = "x", quantity = base_acceleration, direction = [1, 0, 0] },
        ]
        spectral_density_real = [[[0.01]], [[0.01]], [[0.04]], [[0.02]], [[0.005]]] m^2/s^3
        convention = one_sided_per_hertz
        interpolation = linear_frequency
        extrapolation = reject
        equivalent_degrees_of_freedom = 32
    }
}

study modal_random_response_experimental {
    geometry = geometry.bracket
    mesh = mesh.bracket
    model = model.random_environment
    require formulation = experimental
    analysis modes {
        structural modal { modes = 30 }
        retain basis
    }
    analysis random_response after analysis.modes {
        structural random_response {
            basis = analysis.modes.state.basis
            excitation = model.random_excitation.base_motion
            modal_damping_ratio = 0.03
            minimum_cumulative_mass_ratio = 0.9
        }
    }
    output displacement = analysis.random_response.field.node.displacement
}
