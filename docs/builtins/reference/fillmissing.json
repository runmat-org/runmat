{
  "title": "fillmissing",
  "category": "missing",
  "keywords": ["fillmissing", "missing", "NaN", "string", "table", "constant", "previous", "next", "linear"],
  "summary": "Fill missing entries using constant, neighbor, interpolation, or summary methods.",
  "gpu_support": {"elementwise": false, "reduction": false, "precisions": [], "broadcasting": "none", "notes": "GPU inputs are gathered before filling."},
  "fusion": {"elementwise": false, "reduction": false, "max_inputs": 3, "constants": "inline"},
  "requires_feature": null,
  "tested": {"unit": "builtins::missing::tests", "integration": "crates/runmat-vm/tests/missing_values.rs"},
  "description": "`fillmissing(A, method, ...)` replaces missing values while preserving the input shape.",
  "behaviors": [
    "Numeric arrays support `\"constant\"`, `\"previous\"`, `\"next\"`, `\"nearest\"`, `\"linear\"`, `\"mean\"`, and `\"median\"`.",
    "String arrays support `\"constant\"`, `\"previous\"`, `\"next\"`, and `\"nearest\"`.",
    "Cell arrays support `\"constant\"` replacement.",
    "Tables apply filling variable-by-variable and return a table plus an optional logical mask; incompatible variable/method combinations report an error.",
    "The optional dimension argument may be supplied as `1`, `2`, or as a `\"dim\", value` pair. Without an explicit dimension, the first non-singleton dimension is used."
  ],
  "examples": [
    {"description": "Fill by interpolation", "input": "B = fillmissing([1 NaN 3], 'linear')", "output": "B = [1 2 3]"},
    {"description": "Fill with a constant", "input": "B = fillmissing([1 NaN 3], 'constant', 0)", "output": "B = [1 0 3]"}
  ],
  "links": [{"label": "ismissing", "url": "./ismissing"}, {"label": "rmmissing", "url": "./rmmissing"}, {"label": "standardizeMissing", "url": "./standardizeMissing"}],
  "source": {"label": "`crates/runmat-runtime/src/builtins/missing/mod.rs`", "url": "https://github.com/runmat-org/runmat/blob/main/crates/runmat-runtime/src/builtins/missing/mod.rs"}
}
