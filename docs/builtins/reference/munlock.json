    "constants": "inline"
  },
  "requires_feature": null,
  "tested": {
    "unit": "builtins::introspection::debugging::tests::mlock_mislocked_munlock_current_function",
    "integration": "debugger_compat_commands_execute_through_core"
  },
  "description": "`munlock` clears lock state recorded by `mlock`.",
  "behaviors": [
    "`munlock` with no input unlocks the active function or script.",
    "`munlock(fun)` unlocks the named function or script.",
    "Unlocking an unlocked name is allowed and has no effect."
  ],
  "examples": [
    {
      "description": "Unlock a named function",
      "input": "munlock('myFunction')"
    }
  ],
