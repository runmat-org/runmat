{
  "title": "munlock",
  "category": "introspection",
  "keywords": ["munlock", "persistent", "lock", "function"],
  "summary": "Remove a function or script from RunMat's lock compatibility registry.",
  "gpu_support": {
    "elementwise": false,
    "reduction": false,
    "precisions": [],
