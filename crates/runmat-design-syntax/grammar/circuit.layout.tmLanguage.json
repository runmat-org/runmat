{
  "name": "circuit-layout",
  "scopeName": "source.circuit-layout",
  "fileTypes": [
    "circuit.layout"
  ],
  "generated": "scripts/docs/fea-grammar.mjs from the RunMat dialect registry and front-end registries; do not edit by hand",
  "patterns": [
    {
      "name": "comment.line.double-slash.circuit-layout",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.circuit-layout",
      "begin": "\"",
      "end": "\""
    },
    {
      "match": "(-?\\b\\d+(?:\\.\\d+)?(?:[eE][+\\-]?\\d+)?\\b|\\])(\\s*)((?:delta_degC|degC|gram|inch|GHz|GPa|GiB|KiB|MHz|MPa|MiB|deg|kHz|kPa|rad|Hz|MV|MW|Pa|cm|ft|in|kA|kN|kV|kW|kg|km|mA|mT|mV|mW|mm|ms|nm|ns|um|us|A|B|C|J|K|N|T|V|W|g|m|s|%)(?:\\s*[/*]\\s*(?:delta_degC|degC|gram|inch|GHz|GPa|GiB|KiB|MHz|MPa|MiB|deg|kHz|kPa|rad|Hz|MV|MW|Pa|cm|ft|in|kA|kN|kV|kW|kg|km|mA|mT|mV|mW|mm|ms|nm|ns|um|us|A|B|C|J|K|N|T|V|W|g|m|s|%)|\\^-?\\d+)*)(?![\\w%])",
      "captures": {
        "1": {
          "patterns": [
            {
              "name": "constant.numeric.circuit-layout",
              "match": "-?\\d.*"
            }
          ]
        },
        "3": {
          "name": "support.type.unit.circuit-layout"
        }
      }
    },
    {
      "name": "keyword.control.circuit-layout",
      "match": "(?<![\\w])(?:constrain|property|publish|layout|runmat|solved|check|input|link|when|let|std|use)(?![\\w])"
    },
    {
      "name": "storage.type.circuit-layout",
      "match": "(?<![\\w])(?:component_class|description|component|courtyard|diff_pair|dimension|footprint|net_class|fiducial|compare|graphic|keepout|outline|package|stackup|version|cutout|finish|layout|limits|region|layer|model|track|body|name|pour|room|rule|silk|sync|text|uuid|arc|fab|net|pad|smd|via)(?![\\w])"
    },
    {
      "name": "keyword.other.circuit-layout",
      "match": "(?<![\\w])(?:from|over|for|as|at|in|of|on|to)(?![\\w])"
    },
    {
      "name": "constant.language.circuit-layout",
      "match": "(?<![\\w])(?:false|none|true)(?![\\w])"
    },
    {
      "name": "variable.other.assignment.circuit-layout",
      "match": "\\b[a-zA-Z_]\\w*(?=\\s*=(?!=))"
    },
    {
      "name": "constant.numeric.circuit-layout",
      "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+\\-]?\\d+)?\\b"
    },
    {
      "name": "keyword.operator.circuit-layout",
      "match": "±|\\+/-|@|[=:;]"
    }
  ],
  "repository": {},
