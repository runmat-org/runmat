{
  "name": "part",
  "scopeName": "source.part",
  "fileTypes": [
    "part"
  ],
  "generated": "scripts/docs/fea-grammar.mjs from the RunMat dialect registry and front-end registries; do not edit by hand",
  "patterns": [
    {
      "name": "comment.line.double-slash.part",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.part",
      "begin": "\"",
      "end": "\""
    },
    {
      "match": "(-?\\b\\d+(?:\\.\\d+)?(?:[eE][+\\-]?\\d+)?\\b|\\])(\\s*)((?:delta_degC|degC|gram|inch|GHz|GPa|GiB|KiB|MHz|MPa|MiB|deg|kHz|kPa|rad|Hz|MV|MW|Pa|cm|ft|in|kA|kN|kV|kW|kg|km|mA|mT|mV|mW|mm|ms|nm|ns|um|us|A|B|C|J|K|N|T|V|W|g|m|s|%)(?:\\s*[/*]\\s*(?:delta_degC|degC|gram|inch|GHz|GPa|GiB|KiB|MHz|MPa|MiB|deg|kHz|kPa|rad|Hz|MV|MW|Pa|cm|ft|in|kA|kN|kV|kW|kg|km|mA|mT|mV|mW|mm|ms|nm|ns|um|us|A|B|C|J|K|N|T|V|W|g|m|s|%)|\\^-?\\d+)*)(?![\\w%])",
      "captures": {
        "1": {
          "patterns": [
            {
              "name": "constant.numeric.part",
              "match": "-?\\d.*"
            }
          ]
        },
        "3": {
          "name": "support.type.unit.part"
        }
      }
    },
    {
      "name": "support.function.part",
      "match": "(?<![\\w])(?:mate_connector|edges_between|perpendicular|construction|face_fillet|sheet_metal|through_all|coincident|full_round|horizontal|up_to_next|symmetric|vertex_of|distance|parallel|vertical|weldment|body_op|boolean|chamfer|extrude|library|pattern|revolve|surface|tangent|circle|direct|emboss|fillet|import|length|mirror|origin|radius|sketch|thread|angle|curve|draft|equal|frame|limit|piece|plane|point|shell|split|sweep|up_to|axis|hole|line|loft|mold|arc|fix|rib)(?![\\w])"
    },
    {
      "name": "keyword.control.part",
      "match": "(?<![\\w])(?:constrain|property|publish|runmat|solved|check|input|part|link|when|let|std|use)(?![\\w])"
    },
    {
      "name": "storage.type.part",
      "match": "(?<![\\w])(?:configuration|feature_def|material|feature|publish|output|region|sketch|use)(?![\\w])"
    },
    {
      "name": "keyword.other.part",
      "match": "(?<![\\w])(?:from|over|for|as|at|in|of|on|to)(?![\\w])"
    },
    {
      "name": "constant.language.part",
      "match": "(?<![\\w])(?:false|none|true)(?![\\w])"
    },
    {
      "name": "variable.other.assignment.part",
      "match": "\\b[a-zA-Z_]\\w*(?=\\s*=(?!=))"
    },
    {
      "name": "constant.numeric.part",
      "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+\\-]?\\d+)?\\b"
    },
    {
      "name": "keyword.operator.part",
      "match": "±|\\+/-|@|[=:;]"
    }
  ],
