runmat 0.7
std 1

// An RC low-pass filter whose resistor comes from its corner frequency: rcResistor.m in this
// folder computes R1 from the corner and C1, so changing `fc` recomputes it.
circuit lowpass {
    root = main
    sheet main {
        component R1 = { part = "R0402-10K", value = rcResistor(fc = 160 Hz, c = 100 nF) as ohm }
        component C1 = { part = "C0402-100N" }
        component P1 = { part = "PAD-WIRE-20AWG" }
        component P2 = { part = "PAD-WIRE-20AWG" }
        component P3 = { part = "PAD-WIRE-20AWG" }
        net GND = { global = true, power_flag = true }
        connect = [net.IN, "P1.1", "R1.1"]
        connect = [net.OUT, "R1.2", "C1.1", "P3.1"]
        connect = [net.GND, "C1.2", "P2.1"]
    }

    // The corner the resistor was sized for, measured: the -3 dB bandwidth at OUT.
    simulation corner {
        sheet = main
        source VIN = { p = net.IN, ac = 1 V }
        analysis response = ac { from = 1 Hz, to = 100 kHz, points = 100 }
        probe = [net.IN, net.OUT]
        measure f3db = { of = response, bandwidth = net.OUT, spec = { min = 150 Hz, max = 170 Hz } }
    }
}
