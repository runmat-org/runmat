import function makePart from "./makePart.m"

geometry part {
    generated by function.makePart { arguments {} }
    region body : solid {
        select result
        expect exactly_one
    }
    region surface : face {
        select result
        expect one_or_more
    }
}
mesh volume on geometry.part {
    tetrahedra {
        order = linear
        target_size = 0.5 m
        maximum_deviation = 0.02 m
    }
}
material conductor {
    mass_density = 2 kg/m^3
    thermal {
        reference_temperature = 300 K
        modulus_temperature_coefficient = 0 K^-1
        conductivity = 3 W/m/K
        specific_heat = 4 J/kg/K
        expansion_coefficient = 0 K^-1
    }
}
model temperature {
    thermal { reference_temperature = 300 K }
    assign material.conductor to geometry.part.region.body
    constraint equilibrium {
        thermal.temperature {
            target = geometry.part.region.surface
            value = 300 K
        }
    }
    initial uniform_start {
        thermal.temperature {
            target = whole_model
            uniform = 300 K
        }
    }
}
study response {
    geometry = geometry.part
    mesh = mesh.volume
    model = model.temperature
    analysis heat { thermal steady {} }
    output temperature = analysis.heat.field.node.temperature
}
