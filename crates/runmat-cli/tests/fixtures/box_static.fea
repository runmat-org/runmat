version: 1
kind: study
id: canonical_box_static

geometry:
  path: ../../../runmat-geometry/io/tests/fixtures/box.brep
  units: meter

model:
  template: linear_static_structural
  defaults: none

materials:
  steel:
    name: Structural steel
    mechanical:
      youngs_modulus_pa: 200000000000.0
      poisson_ratio: 0.3
      density_kg_per_m3: 7850.0

regions:
  fixed_face:
    selector: { id: face_000001 }
  loaded_face:
    selector: { id: face_000002 }

constraints:
  - structural:
      constraint_id: fixed_support
      frame: global
      kind:
        fixed:
          target:
            region_id: fixed_face
            entity_dimension: face
            expected_topology: boundary_face
            cardinality: one_or_more

signals:
  - force:
      signal_id: applied_force_signal
      shape: scalar
      frame: null
      representation:
        constant:
          scalar: { newtons: 1000.0 }
      precision: real64
      evidence:
        max_absolute_error: null
        max_relative_error: null
        derivative_max_absolute_error: null
        sample_count: 1
      provenance: authored

excitation_cases:
  - case_id: static_load
    action_ids: [applied_force]
    activation: always

excitations:
  - force:
      excitation_id: applied_force
      case_id: static_load
      target:
        region:
          region_id: loaded_face
          entity_dimension: face
          expected_topology: boundary_face
          cardinality: one_or_more
      frame: global
      direction: { vector: [0.0, -1.0, 0.0] }
      distribution: preserve_resultant
      kinematics: fixed_frame
      signal_id: applied_force_signal
      active_step_ids: [step_default_static]
      combination_group: null
      projection:
        preserve_resultant: true
        preserve_moment: false
        relative_tolerance: 1.0e-10

mesh:
  target_edge_length_m: 10.0
  maximum_chordal_deviation_m: 0.1
  maximum_elements: 10000
  deterministic_seed: 7

sequence:
  sequence_id: canonical_box_static_sequence
  steps:
    - step_id: step_default_static
      family: structural
      procedure: static
      solution_space: direct
      independent_domain: static
      activations:
        - object: { constraint: fixed_support }
          lifecycle: activate
        - object: { excitation: applied_force }
          lifecycle: activate
      state_inputs: []
      state_outputs:
        - state_id: structural_primary
          kind: structural_primary
          completeness: complete
          persistence: until_dependents_complete
      observations: []
      accuracy:
        accuracy_plan_id: step_default_static.accuracy
        criteria:
          - criterion_id: algebraic_residual
            target: global_equilibrium
            contribution: algebraic
            tolerance: { relative: 1.0e-8 }
            evidence: residual_bound
            mandatory: true
        unavailable_evidence: mark_indeterminate_experimental
        exceeded_limit: fail
        equivalence: { relative_tolerance: 1.0e-10 }
        resources:
          maximum_refinement_cycles: 0
          maximum_solver_tightenings: 0
          maximum_samples: 1000000
          maximum_wall_time_milliseconds: 3600000
          maximum_resident_bytes: 8589934592
      restart: fresh
  dependencies: []
  transitions: []
  branches: []

execution:
  - step: step_default_static
    backend: cpu
    requirement: experimental
