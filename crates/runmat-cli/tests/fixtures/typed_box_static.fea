geometry part {
    construct {
        feature body = box(width = 1 m, depth = 1 m, height = 1 m)
        result = feature.body
    }

    region body : solid {
        select result
        expect exactly_one
    }

    region support : face {
        select result
        expect one_or_more
    }
}

mesh volume on geometry.part {
    tetrahedra {
        order = linear
        target_size = 10 m
        maximum_deviation = 0.1 m
    }
}

material steel {
    mass_density = 7850 kg/m^3
    elastic {
        youngs_modulus = 200 GPa
        poisson_ratio = 0.3
    }
}

model structure {
    assign material.steel to geometry.part.region.body

    constraint base {
        structural.fixed { target = geometry.part.region.support }
    }
}

study static {
    geometry = geometry.part
    mesh = mesh.volume
    model = model.structure

    analysis solve {
        structural static {}
    }

    output displacement = analysis.solve.field.node.displacement
}
