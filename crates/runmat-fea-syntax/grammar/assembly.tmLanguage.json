    {
      "match": "(-?\\b\\d+(?:\\.\\d+)?(?:[eE][+\\-]?\\d+)?\\b|\\])(\\s*)((?:delta_degC|degC|gram|inch|GHz|GPa|GiB|KiB|MHz|MPa|MiB|deg|kHz|kPa|rad|Hz|MV|MW|Pa|cm|ft|in|kA|kN|kV|kW|kg|km|mA|mT|mV|mW|mm|ms|nm|ns|um|us|A|B|C|J|K|N|T|V|W|g|m|s|%)(?:\\s*[/*]\\s*(?:delta_degC|degC|gram|inch|GHz|GPa|GiB|KiB|MHz|MPa|MiB|deg|kHz|kPa|rad|Hz|MV|MW|Pa|cm|ft|in|kA|kN|kV|kW|kg|km|mA|mT|mV|mW|mm|ms|nm|ns|um|us|A|B|C|J|K|N|T|V|W|g|m|s|%)|\\^-?\\d+)*)(?![\\w%])",
      "captures": {
        "1": {
          "patterns": [
            {
              "name": "constant.numeric.assembly",
              "match": "-?\\d.*"
            }
          ]
        },
        "3": {
          "name": "support.type.unit.assembly"
        }
      }
    },
    {
      "name": "keyword.control.assembly",
      "match": "(?<![\\w])(?:constrain|assembly|property|publish|runmat|solved|check|input|link|when|let|std|use)(?![\\w])"
    },
    {
      "name": "storage.type.assembly",
      "match": "(?<![\\w])(?:configuration|occurrence|connector|fasteners|envelope|exploded|property|pattern|publish|mirror|mate)(?![\\w])"
    },
    {
      "name": "keyword.other.assembly",
      "match": "(?<![\\w])(?:from|over|for|as|at|in|of|on|to)(?![\\w])"
    },
    {
      "name": "constant.language.assembly",
      "match": "(?<![\\w])(?:false|none|true)(?![\\w])"
    },
    {
      "name": "variable.other.assignment.assembly",
      "match": "\\b[a-zA-Z_]\\w*(?=\\s*=(?!=))"
    },
    {
      "name": "constant.numeric.assembly",
      "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+\\-]?\\d+)?\\b"
    },
    {
      "name": "keyword.operator.assembly",
      "match": "±|\\+/-|@|[=:;]"
    }
