    net "/mcu/LED1_K"
    net "/mcu/LED2_K"
    net "/conn/VBUS"
    net "/conn/CC1"
    net USB_DP
    net USB_DN
    net "/conn/CC2"
    net RC_RX
    net RC_TX
    net CURR
    net TLM
    net M1
    net M2
    net M3
    net M4
    net VTX_TX
    net VTX_RX
    net GPS_VCC : supply
    net GPS_TX
    net GPS_RX
    net I2C_SCL
    net I2C_SDA
    net "/mcu/BOOT0"
    net "/mcu/LED1"
    net "/mcu/LED2"
