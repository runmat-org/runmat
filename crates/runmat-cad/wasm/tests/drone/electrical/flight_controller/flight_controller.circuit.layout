runmat 0.7
std 1

use circuit flight_controller

layout flight_controller {
    stackup rigid {
        finish = ENIG
        layer "F.Mask" = { kind = mask, thickness = 0.02, material = solder_mask }
        layer "F.Cu" = { kind = copper, thickness = 0.03479, weight = 1, material = copper }
        layer "dielectric 1" = { kind = prepreg, thickness = 0.48521, material = { name = "FR-4 prepreg", dk = 4.1, df = 0.02, conductivity = 0, k_inplane = 0.8, k_through = 0.3, density = 1850, cp = 1100, cte_ppm = 14 } }
        layer "In1.Cu" = { kind = copper, thickness = 0.017395, weight = 0.5, material = copper }
        layer "dielectric 2" = { kind = core, thickness = 0.48521, material = fr4 }
        layer "In2.Cu" = { kind = copper, thickness = 0.017395, weight = 0.5, material = copper }
        layer "dielectric 3" = { kind = prepreg, thickness = 0.48521, material = { name = "FR-4 prepreg", dk = 4.1, df = 0.02, conductivity = 0, k_inplane = 0.8, k_through = 0.3, density = 1850, cp = 1100, cte_ppm = 14 } }
        layer "B.Cu" = { kind = copper, thickness = 0.03479, weight = 1, material = copper }
        layer "B.Mask" = { kind = mask, thickness = 0.02, material = solder_mask }
    }
    outline = [[-17, -18], [17, -18], [18, -17], [18, 17], [17, 18], [-17, 18], [-18, 17], [-18, -17]]
    limits = { clearance = 0.1, track = 0.1, via_diameter = 0.45, drill = 0.2, annular = 0.1, hole_to_hole = 0.25, copper_to_edge = 0.3, silk_to_pad = 0.1, microvia_drill = 0.1 }
    fabrication = { preset = fab_house, part_number = "CD-EL-710", zip = true }
    net_class digital = { track_width = 0.1 mm, clearance = 0.1 mm }
    net_class power = { track_width = 0.4 mm, clearance = 0.15 mm }
    net_class supply = { track_width = 0.25 mm, clearance = 0.1 mm }
    net "/mcu/OSC_IN"
    net GND : supply
    net "/mcu/OSC_OUT"
    net "+3V3" : supply
    net "/mcu/VCAP"
    net "/mcu/NRST"
    net VBAT : power
    net "/pwr/BST"
    net "/pwr/SW" : power
    net "+5V" : power
    net "/pwr/FB"
