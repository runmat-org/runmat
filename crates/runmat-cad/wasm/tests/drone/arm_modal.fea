// The folding arm's natural frequencies against the propeller's excitation.
//
// Geometry: ./geometry/arm_study.step, exported from arm_study.assembly (the arm at its 88.2 mm
// default and the motor pod on its pad; the drone's rear arms are 90.6 mm, so the check below
// takes the rear arm). The arm turns on the hinge pin, and the latch holds it unfolded; fixing
// the knuckle's pin bore is stiffer than the pin, lugs and latch, so these frequencies are an
// upper bound on the installed arm's.
//
// Material: a 0-dominated carbon prepreg laminate ([0/0/90/0]s, three quarters of the plies
// along the arm), E = 90 GPa along the arm and 1550 kg/m^3, modelled as isotropic (the flap and
// lag modes bend the arm along its fibres). The 0/90 laminate (65 GPa) put the rear arm's first
// flap mode at about 433 Hz, under the 476 Hz target below.
// The pod carries the motor, folding propeller, and cowl as one lumped mass: 40 g over the
// cowl's 6.26 cm^3 (pocketed over the arm's pad) is 6390 kg/m^3.
//
// Excitation: the 166 mm two-blade prop (C_T about 0.10) holds the drone's 746 g all-up weight
// at about 8,400 rpm, and full throttle (11,900 rpm) gives a 2:1 thrust-to-weight ratio, so the
// once-per-revolution imbalance runs 140-198 Hz and the two-blade pass 280-397 Hz. The first
// flap mode should sit above 1.2 x 397 = 476 Hz.
// Check: the lofted elliptic beam (root 16 x 13 mm, tip 11 x 7 mm) under a tip load, integrated
// station by station, gives k = 448 N/mm at 90 GPa; with the 40 g pod and the arm's effective
// 3.8 g, f1 = sqrt(k/m)/(2 pi) = 509 Hz, 1.28 x the 397 Hz blade pass.

geometry arm {
    file = "./geometry/arm_study.step"
    units = mm
    interfaces = shared
    region arm : solid { select name "arm"; expect exactly_one }
    region pod : solid { select name "motor_pod"; expect exactly_one }
    region root : face { select name "root"; expect one_or_more }
}

mesh arm on geometry.arm {
    tetrahedra {
        order = quadratic
        target_size = 3 mm
        maximum_deviation = 0.1 mm
    }
}

material prepreg_carbon {
    mass_density = 1550 kg/m^3
    elastic {
        youngs_modulus = 90 GPa
        poisson_ratio = 0.3
    }
}

material pod_lumped {
    mass_density = 6390 kg/m^3
    elastic {
        youngs_modulus = 9 GPa
        poisson_ratio = 0.35
    }
}

model pinned_arm {
    assign material.prepreg_carbon to geometry.arm.region.arm
    assign material.pod_lumped to geometry.arm.region.pod
    constraint hinge {
        structural.fixed { target = geometry.arm.region.root }
    }
}

study arm_modes {
    geometry = geometry.arm
    mesh = mesh.arm
    model = model.pinned_arm
    analysis modes { structural modal { modes = 4 } retain basis }
    output shapes = analysis.modes.field.node.displacement
}
