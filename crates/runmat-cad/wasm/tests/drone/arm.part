runmat 0.7
std 1

// A folding arm: a moulded carbon-fibre beam lofted from the hinge knuckle to the motor pod's pad.
// Its origin is the hinge axis (z) at the knuckle's mid-height and it runs along +x; the pad at
// the tip rises by `rise` so the props clear the body. The knuckle turns on the hinge pin, and
// two screws hold the motor pod to the pad.
part arm {
    input length : length = 88.2 mm
    input rise : length = 5.2 mm
    feature knuckle_base = plane.offset(base = origin.xy, distance = -6.5 mm)
    sketch knuckle_b on plane.knuckle_base {
        c = circle(center = [0 mm, 0 mm], radius = 7 mm)
    }
    feature knuckle = extrude(profile = sketch.knuckle_b, distance = 13 mm)
    feature beam_st0 = plane.offset(base = origin.yz, distance = 4 mm)
    sketch beam_s0 on plane.beam_st0 {
        c = spline(points = [[0 mm, 6.5 mm], [2.594 mm, 6.315 mm], [4.49 mm, 5.766 mm], [5.993 mm, 4.869 mm], [7.096 mm, 3.648 mm], [7.772 mm, 2.107 mm], [8 mm, 0 mm], [7.772 mm, -2.107 mm], [7.096 mm, -3.648 mm], [5.993 mm, -4.869 mm], [4.49 mm, -5.766 mm], [2.594 mm, -6.315 mm], [0 mm, -6.5 mm], [-2.594 mm, -6.315 mm], [-4.49 mm, -5.766 mm], [-5.993 mm, -4.869 mm], [-7.096 mm, -3.648 mm], [-7.772 mm, -2.107 mm], [-8 mm, 0 mm], [-7.772 mm, 2.107 mm], [-7.096 mm, 3.648 mm], [-5.993 mm, 4.869 mm], [-4.49 mm, 5.766 mm], [-2.594 mm, 6.315 mm]], closed)
    }
    feature beam_st1 = plane.offset(base = origin.yz, distance = input.length * 0.45)
    sketch beam_s1 on plane.beam_st1 {
        c = spline(points = [[0 mm, 5.6 mm + input.rise * 0.45], [2.205 mm, 5.441 mm + input.rise * 0.45], [3.816 mm, 4.967 mm + input.rise * 0.45], [5.094 mm, 4.195 mm + input.rise * 0.45], [6.032 mm, 3.143 mm + input.rise * 0.45], [6.606 mm, 1.816 mm + input.rise * 0.45], [6.8 mm, 0 mm + input.rise * 0.45], [6.606 mm, -1.816 mm + input.rise * 0.45], [6.032 mm, -3.143 mm + input.rise * 0.45], [5.094 mm, -4.195 mm + input.rise * 0.45], [3.816 mm, -4.967 mm + input.rise * 0.45], [2.205 mm, -5.441 mm + input.rise * 0.45], [0 mm, -5.6 mm + input.rise * 0.45], [-2.205 mm, -5.441 mm + input.rise * 0.45], [-3.816 mm, -4.967 mm + input.rise * 0.45], [-5.094 mm, -4.195 mm + input.rise * 0.45], [-6.032 mm, -3.143 mm + input.rise * 0.45], [-6.606 mm, -1.816 mm + input.rise * 0.45], [-6.8 mm, 0 mm + input.rise * 0.45], [-6.606 mm, 1.816 mm + input.rise * 0.45], [-6.032 mm, 3.143 mm + input.rise * 0.45], [-5.094 mm, 4.195 mm + input.rise * 0.45], [-3.816 mm, 4.967 mm + input.rise * 0.45], [-2.205 mm, 5.441 mm + input.rise * 0.45]], closed)
    }
    feature beam_st2 = plane.offset(base = origin.yz, distance = input.length - 6 mm)
    sketch beam_s2 on plane.beam_st2 {
        c = spline(points = [[0 mm, 4 mm + input.rise], [1.783 mm, 3.858 mm + input.rise], [3.087 mm, 3.435 mm + input.rise], [4.12 mm, 2.746 mm + input.rise], [4.879 mm, 1.806 mm + input.rise], [5.343 mm, 0.621 mm + input.rise], [5.5 mm, -1 mm + input.rise], [5.343 mm, -2.621 mm + input.rise], [4.879 mm, -3.806 mm + input.rise], [4.12 mm, -4.746 mm + input.rise], [3.087 mm, -5.435 mm + input.rise], [1.783 mm, -5.858 mm + input.rise], [0 mm, -6 mm + input.rise], [-1.783 mm, -5.858 mm + input.rise], [-3.087 mm, -5.435 mm + input.rise], [-4.12 mm, -4.746 mm + input.rise], [-4.879 mm, -3.806 mm + input.rise], [-5.343 mm, -2.621 mm + input.rise], [-5.5 mm, -1 mm + input.rise], [-5.343 mm, 0.621 mm + input.rise], [-4.879 mm, 1.806 mm + input.rise], [-4.12 mm, 2.746 mm + input.rise], [-3.087 mm, 3.435 mm + input.rise], [-1.783 mm, 3.858 mm + input.rise]], closed)
    }
    feature beam = loft(profiles = [sketch.beam_s0, sketch.beam_s1, sketch.beam_s2], mode = add)
    feature pad_base = plane.offset(base = origin.xy, distance = input.rise - 4 mm)
    sketch pad_s on plane.pad_base {
        c = circle(center = [input.length, 0 mm], radius = 9 mm)
    }
    feature pad = extrude(profile = sketch.pad_s, distance = 8 mm, mode = add)
    feature knuckle_cut = plane.offset(base = origin.xy, distance = -7 mm)
    sketch bores_s on plane.knuckle_cut {
        pin = circle(center = [0 mm, 0 mm], radius = 2.05 mm)
    }
    feature bores = extrude(profile = sketch.bores_s, through_all, mode = cut)
    // The motor's four M2 screws pass up through the pad and the pod's floor into the
    // stator, on a 12 mm bolt circle (close-fit clearance).
    feature motor_holes = hole(
        face = feature.pad.face.end,
        at = {
            a = point(input.length + 6 mm, 0 mm, input.rise + 4 mm),
            b = point(input.length, 6 mm, input.rise + 4 mm),
            c = point(input.length - 6 mm, 0 mm, input.rise + 4 mm),
            d = point(input.length, -6 mm, input.rise + 4 mm)
        },
        spec = { standard = iso, size = "M2", fit = close },
        through_all
    )

    // The knuckle's bore, where the hinge pin carries the arm, and the pad's top face, where the
    // motor pod's thrust comes in.
    region root : face = { select = [feature.bores.face.side(bores_s.pin)], expect = at_least_one }
    region motor_seat : face = { select = [feature.pad.face.end], expect = at_least_one }
    output arm = { body = feature.knuckle.body, part_number = "CD-AR-210", material = "carbon_fiber", color = "#3C4048" }

    // Datums: A the motor seat, B the hinge bore's axis, C the knuckle's underside.
    datum A = { on = feature.pad.face.end }
    datum B = { on = feature.bores.face.side(bores_s.pin) }
    datum C = { on = feature.knuckle.face.start }
    // The hinge bore runs on a 4 mm ground pin (H8-class clearance), square to the motor seat
    // so the four props stay in one plane; the seat is flat and parallel to the knuckle face.
    size pin_bore = { on = [feature.bores.face.side(bores_s.pin)], size = 4.1 mm ± [0.018 mm, 0 mm] }
    location pin_to_motor = { from = feature.bores.face.side(bores_s.pin), to = feature.pad.face.side(pad_s.c), distance = input.length ± 0.1 mm }
    location motor_bolt_circle = { from = feature.motor_holes.face.wall(a), to = feature.motor_holes.face.wall(c), distance = 12 mm ± 0.05 mm }
    tolerance bore_square = { characteristic = perpendicularity, on = [feature.bores.face.side(bores_s.pin)], tolerance = 0.02 mm, diametral = true, datums = [{ label = "A" }] }
    tolerance seat_parallel = { characteristic = parallelism, on = [feature.pad.face.end], tolerance = 0.03 mm, datums = [{ label = "C" }] }
    tolerance motor_position = { characteristic = position, on = [feature.motor_holes.face.wall(a)], tolerance = 0.1 mm, diametral = true, modifier = mmc, datums = [{ label = "A" }, { label = "B" }, { label = "C" }] }
    finish seat = { on = [feature.pad.face.end], ra = 0.8 um }
    finish bore = { on = [feature.bores.face.side(bores_s.pin)], ra = 0.8 um, process = "reamed" }
}
