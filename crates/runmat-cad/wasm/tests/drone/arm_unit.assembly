runmat 0.7
std 1

// One folding arm as it swings on its hinge: the arm, the motor pod at its tip (turned by
// `pod_tilt` about the arm's axis so the motor stays vertical when the hinge is tilted), the
// motor, the folding propeller and the landing leg with its antenna. Its origin is the hinge
// axis (z), and the arm runs along +x.
assembly arm_unit {
    input length : length = 88 mm
    input rise : length = 11 mm
    input pod_tilt : angle = 0 deg
    input blade_a : angle = 0 deg
    input blade_b : angle = 180 deg

    use part arm from "arm.part" as arm {
        configuration = { select = inputs, values = { length = input.length, rise = input.rise } }
    }
    use assembly motor_station from "motor_station.assembly" as motor {
        configuration = { select = inputs, values = { blade_a = input.blade_a, blade_b = input.blade_b } }
        placement = { placement = offset, offset = { translation = [input.length, 0 mm, input.rise + 4 mm], rotation = { rotation = axis_angle, axis = [1, 0, 0], angle = input.pod_tilt } } }
    }
}
