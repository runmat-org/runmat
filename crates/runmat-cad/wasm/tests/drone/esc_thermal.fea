// The 4-in-1 ESC at full throttle inside the closed body: its losses conduct through the four
// bosses into the lower shell, and the shell's skin gives them to the propellers' downwash.
//
// Geometry: ./geometry/esc_thermal.step, exported from esc_thermal.assembly (the lower shell
// with its bosses and the ESC as a plate on them).
//
// Heat: copied by hand from the ESC's gate_drive simulation and its parts, because the FEA does
// not yet take a circuit's losses or a routed board as a heat source (brief to the FEA lane,
// 2026-11-05). Per channel at 20 A: conduction in the two conducting FETs 20^2 x 1.6 mOhm x 2 =
// 1.28 W; switching 0.5 x 22.2 V x 20 A x (7 ns + 7 ns) x 48 kHz = 0.15 W (7 ns edges from the
// simulation); gate drive 6 x 35 nC x 10 V x 48 kHz = 0.10 W; driver and MCU about 0.03 W. That
// is 1.56 W a channel and 6.2 W for the board: 6.2 W over 4,326 mm^3 is 1.43e6 W/m^3.
//
// Board: a four-layer 1 oz stack spreads heat in plane at about 35 W/m/K (four 35 um copper
// layers in 1.6 mm). The plate is isotropic, so it overstates through-plane conduction; the
// board-to-boss path is through its plated holes, which the shared interfaces stand in for.
// Shell: polycarbonate (0.2 W/m/K). Skin: forced convection in the downwash, 25 W/m^2/K, at
// 35 degC ambient. The air inside the shell is left out (still air carries little).
// Check: 6.2 W through four 6.8 mm bosses 7.5 mm tall in polycarbonate is R = L / (k A) =
// 7.5e-3 / (0.2 x 4 x 36.3e-6) = 258 K/W, so the bosses alone cannot carry it: the board runs
// hot unless the shell is aluminium-filled or the ESC gets a heat-spreader to the skin.

geometry esc {
    file = "./geometry/esc_thermal.step"
    units = mm
    interfaces = shared
    region board : solid { select name "esc_board"; expect exactly_one }
    region shell : solid { select name "body_bottom"; expect exactly_one }
    region skin : face { select name "skin"; expect one_or_more }
}

mesh esc on geometry.esc {
    tetrahedra {
        order = linear
        target_size = 2.5 mm
        maximum_deviation = 0.1 mm
    }
}

material board_stack {
    mass_density = 2200 kg/m^3
    thermal {
        reference_temperature = 308.15 K
        modulus_temperature_coefficient = 0 K^-1
        expansion_coefficient = 0.000016 K^-1
        conductivity = 35 W/m/K
        specific_heat = 900 J/kg/K
    }
}

material polycarbonate {
    mass_density = 1200 kg/m^3
    thermal {
        reference_temperature = 308.15 K
        modulus_temperature_coefficient = 0 K^-1
        expansion_coefficient = 0.00007 K^-1
        conductivity = 0.2 W/m/K
        specific_heat = 1200 J/kg/K
    }
}

model full_throttle {
    thermal { reference_temperature = 308.15 K }
    assign material.board_stack to geometry.esc.region.board
    assign material.polycarbonate to geometry.esc.region.shell
    load esc_losses { heat_generation on geometry.esc.region.board = 1.43e6 W/m^3 }
    load downwash {
        thermal.convection {
            target = geometry.esc.region.skin
            ambient_temperature = 308.15 K
            coefficient = 25 W/m^2/K
        }
    }
}

study esc_temperature {
    geometry = geometry.esc
    mesh = mesh.esc
    model = model.full_throttle
    analysis heat { thermal steady {} }
    output temperature = analysis.heat.field.node.temperature
    output heat_flux = analysis.heat.field.element.heat_flux
    output peak_board_temperature = max(analysis.heat.field.node.temperature, over = geometry.esc.region.board)
}
