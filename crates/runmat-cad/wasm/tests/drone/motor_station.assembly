runmat 0.7
std 1

// The motor station at an arm's tip: the pod's cowl, the motor's bell, the folding propeller's
// hub and its two blades on their pivots (`blade_a`, `blade_b` turn them about the pivots:
// 0 and 180 deg in flight, folded back along the arm when stowed) and the landing leg with its
// antenna. Its origin is the motor axis at the arm pad's top face.
assembly motor_station {
    input blade_a : angle = 0 deg
    input blade_b : angle = 180 deg

    use part motor_pod from "motor_pod.part" as pod
    use part motor from "motor.part" as motor
    use part prop_hub from "prop_hub.part" as hub
    use part prop_blade from "prop_blade.part" as blade_a {
        placement = { placement = offset, offset = { translation = [9 mm, 0 mm, 18.6 mm], rotation = { rotation = axis_angle, axis = [0, 0, 1], angle = input.blade_a } } }
    }
    use part prop_blade from "prop_blade.part" as blade_b {
        placement = { placement = offset, offset = { translation = [-9 mm, 0 mm, 18.6 mm], rotation = { rotation = axis_angle, axis = [0, 0, 1], angle = input.blade_b } } }
    }
    use part leg from "leg.part" as leg
    use part antenna from "antenna.part" as antenna
}
