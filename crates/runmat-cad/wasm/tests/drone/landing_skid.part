runmat 0.7
std 1

// A landing skid under the body: a moulded glass-filled nylon rail on two tapered struts that
// flare into the belly. The struts' tops are trimmed by the body's own loft, so each skid seats
// flush on the lower shell (bonded and screwed from inside). The two skids stand either side of
// the heatsink's fins and hold the gimbal camera 3 mm off the ground. `side` places the skid's
// centre line (y); its origin is the body origin.
part landing_skid {
    input side : length = 34 mm
    feature sole_plane = plane.offset(base = origin.xy, distance = -21 mm)
    sketch rail_s on plane.sole_plane {
        c = spline(points = [[48.5 mm, -3.5 mm + input.side], [50.019 mm, -3.153 mm + input.side], [51.236 mm, -2.182 mm + input.side], [51.912 mm, -0.779 mm + input.side], [51.912 mm, 0.779 mm + input.side], [51.236 mm, 2.182 mm + input.side], [50.019 mm, 3.153 mm + input.side], [48.5 mm, 3.5 mm + input.side], [-42.5 mm, 3.5 mm + input.side], [-44.019 mm, 3.153 mm + input.side], [-45.236 mm, 2.182 mm + input.side], [-45.912 mm, 0.779 mm + input.side], [-45.912 mm, -0.779 mm + input.side], [-45.236 mm, -2.182 mm + input.side], [-44.019 mm, -3.153 mm + input.side], [-42.5 mm, -3.5 mm + input.side]], closed)
