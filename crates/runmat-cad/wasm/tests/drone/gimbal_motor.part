runmat 0.7
std 1

// A gimbal motor: a flat brushless outrunner with a machined face ring. Its origin is the motor's
// centre and it turns about z; the gimbal sizes each axis's motor by its inputs.
part gimbal_motor {
    input radius : length = 10 mm
    input height : length = 6 mm
    feature base = plane.offset(base = origin.xy, distance = -input.height / 2)
    sketch s on plane.base {
        c = circle(center = [0 mm, 0 mm], radius = input.radius)
    }
    feature can = extrude(profile = sketch.s, distance = input.height)
    feature ring_base = plane.offset(base = origin.xy, distance = input.height / 2 - 0.6 mm)
    sketch ring_s on plane.ring_base {
        c = circle(center = [0 mm, 0 mm], radius = input.radius - 1.6 mm)
    }
    feature ring = extrude(profile = sketch.ring_s, distance = 0.6 mm, mode = cut)
    output gimbal_motor = { body = feature.can.body, part_number = "CD-GB-510", material = "aluminum_6061", color = "#2A2D32" }
}
