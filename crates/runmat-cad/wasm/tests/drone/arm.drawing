runmat 0.7
std 1

// The folding arm's production drawing at 2:1 on A3, third-angle projection. The plan view
// carries the hinge bore (datum B) to the motor axis and the motor's bolt circle; the elevation
// carries the knuckle's height and the pad's thickness; section A-A runs along the arm through
// the hinge bore and the motor holes; detail B enlarges the hinge knuckle; the isometric shows
// the part. GD&T is to datums A (the motor seat), B (the hinge bore) and C (the knuckle's
// underside), as the part's PMI declares them.
drawing arm {
    format a3 = {
        size = { size = iso, name = A3 },
        title_block = [
            { label = "Title", source = { source = literal, text = "Folding arm, front" } },
            { label = "Part number", source = { source = property, name = part_number } },
            { label = "Material", source = { source = property, name = material } },
            { label = "Drawn", source = { source = literal, text = "RunMat Design" } },
            { label = "Scale", source = { source = scale } },
            { label = "Sheet", source = { source = sheet_number } },
            { label = "Rev", source = { source = revision } },
            { label = "Date", source = { source = literal, text = "2026-11-05" } }
        ]
    }

    sheet "1" = { format = a3, scale = [2, 1], projection = third_angle }

    view front = standard(orientation = front, sheet = "1", model = { file = "arm.part" }, at = [125, 165], display = hidden_lines)
    view top = projected(from = front, direction = up, sheet = "1", model = { file = "arm.part" }, at = [125, 235], display = hidden_lines)
    view right = projected(from = front, direction = right, sheet = "1", model = { file = "arm.part" }, at = [272, 165], display = hidden_lines)
    view a_a = section(
        from = top,
        plane = feature.pad.face.side(pad_s.c),
        label = A,
        sheet = "1",
        model = { file = "arm.part" },
        at = [125, 88],
        display = hidden_lines
    )
    view b = detail(
        from = front,
        center = feature.bores.face.side(bores_s.pin),
        radius = 8 mm,
        label = B,
        sheet = "1",
        model = { file = "arm.part" },
        at = [355, 225],
        scale = [4, 1],
        display = hidden_lines
    )
    view iso = standard(orientation = isometric, sheet = "1", model = { file = "arm.part" }, at = [340, 105], scale = [1, 1], display = visible_lines)

    annotation knuckle_height = dimension(style = linear, references = [feature.knuckle.face.start, feature.knuckle.face.end], view = front)
    annotation pad_thickness = dimension(style = linear, references = [feature.pad.face.start, feature.pad.face.end], view = front)
    annotation pin_to_motor = dimension(style = linear, references = [feature.bores.face.side(bores_s.pin), feature.pad.face.side(pad_s.c)], pmi = pin_to_motor, view = top)
    annotation bolt_circle = dimension(style = linear, references = [feature.motor_holes.face.wall(c), feature.motor_holes.face.wall(a)], pmi = motor_bolt_circle, view = top)
    annotation pin_bore = dimension(style = diameter, references = [feature.bores.face.side(bores_s.pin)], pmi = pin_bore, view = top)
    annotation motor_holes = hole_callout(hole = feature.motor_holes.face.wall(b), view = top)
    annotation datum_a = datum_symbol(label = A, view = front)
    annotation datum_b = datum_symbol(label = B, view = top)
    annotation datum_c = datum_symbol(label = C, view = right)
    annotation bore_square = gdt(tolerance = bore_square, view = top)
    annotation motor_position = gdt(tolerance = motor_position, view = top)
    annotation seat_parallel = gdt(tolerance = seat_parallel, view = front)
    annotation seat_finish = surface_finish(on = feature.pad.face.end, view = front)
    annotation bore_finish = surface_finish(on = feature.bores.face.side(bores_s.pin), view = a_a)
    annotation notes = note(
        text = "NOTES:\n1. MATERIAL: {material}, 0/90 PREPREG LAYUP, 2.0 MM MIN WALL.\n2. FINISH: MATTE CLEAR COAT, SEAT AND BORE MASKED.\n3. BREAK SHARP EDGES 0.2 MAX.\n4. DIMENSIONS IN MM. UNTOLERANCED: ISO 2768-m.\n5. PART MARK {part_number} NEAR THE KNUCKLE.",
        view = a_a,
        at = [16, 50]
    )

    table revisions = revision(
        rows = [
            { rev = "A", description = "Initial release", date = "2026-10-28", by = "RunMat Design" },
            { rev = "B", description = "Motor seat to 4x M2 on 12 BC; bore H8", date = "2026-11-05", by = "RunMat Design" }
        ],
        sheet = "1",
        at = [290, 287]
    )
}
