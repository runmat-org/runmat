runmat 0.7
std 1

// The motor station at an arm's tip: the pod's cowl, the motor's bell, the folding propeller's
// hub and its two blades on their pivots (`blade_a`, `blade_b` turn them about the pivots:
// 0 and 180 deg in flight, folded back along the arm when stowed). Its origin is the motor axis
// at the arm pad's top face.
assembly motor_station {
    input blade_a : angle = 0 deg
    input blade_b : angle = 180 deg
    input arm_roll : angle = 0 deg

    use part motor_pod as pod {
        configuration = { select = inputs, values = { arm_roll = input.arm_roll } }
    }
    use part motor as motor
    use part prop_hub as hub
    use part prop_blade as blade_a {
        placement = { placement = offset, offset = { translation = [0 mm, 9 mm, 18.6 mm], rotation = { rotation = axis_angle, axis = [0, 0, 1], angle = input.blade_a + 90 deg } } }
    }
    use part prop_blade as blade_b {
        placement = { placement = offset, offset = { translation = [0 mm, -9 mm, 18.6 mm], rotation = { rotation = axis_angle, axis = [0, 0, 1], angle = input.blade_b + 90 deg } } }
    }
}
