runmat 0.7
std 1

// The status light's window: a clear light pipe that fills the slot at the front of the upper
// shell, lit from the flight controller's status LED below. It is a 2.6 x 15.6 mm obround on the
// window's centres (R1.3 ends at x = 67.5 and 80.5 mm), so it clears the 3 x 16 mm window by
// 0.2 mm all round.
part light_pipe {
    feature base = plane.offset(base = origin.xy, distance = 46.5 mm)
    sketch s on plane.base {
        w_front = arc(center = [80.5 mm, 0 mm], start = [80.5 mm, -1.3 mm], end = [80.5 mm, 1.3 mm])
        w_left = line(start = [80.5 mm, 1.3 mm], end = [67.5 mm, 1.3 mm])
        w_rear = arc(center = [67.5 mm, 0 mm], start = [67.5 mm, 1.3 mm], end = [67.5 mm, -1.3 mm])
        w_right = line(start = [67.5 mm, -1.3 mm], end = [80.5 mm, -1.3 mm])
    }
    feature pipe = extrude(profile = sketch.s, distance = 3.4 mm)
    output light_pipe = { body = feature.pipe.body, part_number = "CD-BD-130", material = "polycarbonate", color = "#8FD3FF" }
}
