    feature belly_openings = extrude(profile = sketch.belly_cut_s, distance = 15 mm, mode = cut)
    region skin : face = { select = [feature.outer.face.side(outer_s0.c)], expect = at_least_one }
    output body_bottom = { body = feature.outer.body, part_number = "CD-BD-120", material = "polycarbonate", color = "#3A3E44" }
}
