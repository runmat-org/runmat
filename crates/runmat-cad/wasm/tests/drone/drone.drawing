runmat 0.7
std 1

// The camera drone's assembly drawing at 1:2 on A3, third-angle projection: the side and plan
// views, an isometric, balloons on the main items and the parts list.
drawing drone {
    format a3 = {
        size = { size = iso, name = A3 },
        title_block = [
            { label = "Title", source = { source = literal, text = "Foldable camera drone" } },
            { label = "Part number", source = { source = literal, text = "CD-100" } },
            { label = "Scale", source = { source = scale } },
            { label = "Sheet", source = { source = sheet_number } },
            { label = "Rev", source = { source = revision } }
        ]
    }

    sheet "1" = { format = a3, scale = [1, 2], projection = third_angle }

    view front = standard(orientation = front, sheet = "1", model = { assembly = drone }, at = [115, 240], display = visible_lines)
    view top = projected(from = front, direction = down, sheet = "1", model = { assembly = drone }, at = [115, 135], display = visible_lines)
    view iso = standard(orientation = isometric, sheet = "1", model = { assembly = drone }, at = [305, 225], display = visible_lines)

    annotation b1 = balloon(occurrence = [{ name = body_top }], table = parts, view = iso)
    annotation b2 = balloon(occurrence = [{ name = body_bottom }], table = parts, view = front)
    annotation b3 = balloon(occurrence = [{ name = battery }], table = parts, view = top)
    annotation b4 = balloon(occurrence = [{ name = arm_front_left }], table = parts, view = top)
    annotation b5 = balloon(occurrence = [{ name = arm_rear_right }], table = parts, view = top)
    annotation b6 = balloon(occurrence = [{ name = gimbal }], table = parts, view = front)
    annotation b7 = balloon(occurrence = [{ name = vision_front_left }], table = parts, view = iso)
    annotation b8 = balloon(occurrence = [{ name = light_pipe }], table = parts, view = iso)

    table parts = bom(view = iso, sheet = "1", at = [0, 0])
}
