runmat 0.7
std 1

// The 4-in-1 ESC as the thermal study sees it: a 52 x 52 x 1.6 mm plate with the board's
// outline and its four stack holes. The FEA reads STEP solids and has no reader for a routed
// board's copper yet, so the board is a plate with the four-layer stack's in-plane conductivity
// and its losses spread over its volume. Its origin is the board's centre on its underside.
part esc_board_thermal {
    sketch s on origin.xy {
        l1 = line(start = [-24 mm, -26 mm], end = [24 mm, -26 mm])
        l2 = line(start = [24 mm, -26 mm], end = [26 mm, -24 mm])
        l3 = line(start = [26 mm, -24 mm], end = [26 mm, 24 mm])
        l4 = line(start = [26 mm, 24 mm], end = [24 mm, 26 mm])
        l5 = line(start = [24 mm, 26 mm], end = [-24 mm, 26 mm])
        l6 = line(start = [-24 mm, 26 mm], end = [-26 mm, 24 mm])
        l7 = line(start = [-26 mm, 24 mm], end = [-26 mm, -24 mm])
        l8 = line(start = [-26 mm, -24 mm], end = [-24 mm, -26 mm])
    }
    feature board = extrude(profile = sketch.s, distance = 1.6 mm)
    sketch holes_s on origin.xy {
        h1 = circle(center = [15.25 mm, 15.25 mm], radius = 1.8 mm)
        h2 = circle(center = [-15.25 mm, 15.25 mm], radius = 1.8 mm)
        h3 = circle(center = [-15.25 mm, -15.25 mm], radius = 1.8 mm)
        h4 = circle(center = [15.25 mm, -15.25 mm], radius = 1.8 mm)
    }
    feature holes = extrude(profile = sketch.holes_s, through_all, mode = cut)
    output esc_board_thermal = { body = feature.board.body, part_number = "CD-EL-720-TH", material = "composite", color = "#1F5F3A" }
}
