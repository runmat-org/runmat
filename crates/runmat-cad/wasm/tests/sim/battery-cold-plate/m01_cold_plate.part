runmat 0.7
std 1

// Module M01 of an EV battery pack on its liquid cold plate: the eight 34 x 500 x 95 mm prismatic
// cells at a 36 mm pitch (the module of runmat-examples/fea/battery-module-cells), a 3 mm
// gap-filler strip under each cell, and a 296 x 520 x 8 mm brazed aluminum cold plate whose top
// carries a 1 mm land under each strip. The coolant (50/50 water-glycol) runs in a four-pass
// serpentine channel, 14 x 4 mm, under the cells' center lines: in at one corner of the plate's
// rear edge, out at the other. The coolant is its own body: the plate is cut by it, so each
// channel wall is one surface with a fluid side ("Channel wall") and a plate side ("Plate
// channel wall").
//
// Laminar sizing at 2 L/min (3.333e-5 m^3/s), 1070 kg/m^3, 3.5 mPa s at 25 degC:
// A = 14 x 4 = 56 mm^2, Dh = 4 A / P = 6.22 mm, U = 0.595 m/s, Re = rho U Dh / mu = 1130.
// The cells sit on z = 0 (their bottoms); the plate's rear edge, with the ports, is y = 510 mm.
// Generated by gen_cold_plate.py (runmat-cad/wasm/tests/sim/battery-cold-plate); the channel
// size, plate thickness and pad thickness are inputs.
part m01_cold_plate {
    input cell_height : length = 95 mm
    input gap_filler : length = 3 mm
    input land : length = 1 mm
    input plate : length = 8 mm
    input channel_width : length = 14 mm
    input channel_depth : length = 4 mm
    input floor : length = 2 mm
    input inlet_y : length = 510 mm

    let half_w = input.channel_width / 2
    let turn_out = 6 mm
    let bottom_in = input.channel_width - let.turn_out
    let top_out = 496 mm
    let top_in = let.top_out - input.channel_width
    let plate_top = -input.gap_filler - input.land
    let plate_bottom = let.plate_top - input.plate

    // The cells, each its own body.
    sketch cell_1_s on origin.xy {
        front = line(start = [0 mm, 0 mm], end = [34 mm, 0 mm])
        right = line(start = [34 mm, 0 mm], end = [34 mm, 500 mm])
        back = line(start = [34 mm, 500 mm], end = [0 mm, 500 mm])
        left = line(start = [0 mm, 500 mm], end = [0 mm, 0 mm])
    }
    feature cell_1 = extrude(profile = sketch.cell_1_s, distance = input.cell_height)
    sketch cell_2_s on origin.xy {
        front = line(start = [36 mm, 0 mm], end = [70 mm, 0 mm])
        right = line(start = [70 mm, 0 mm], end = [70 mm, 500 mm])
        back = line(start = [70 mm, 500 mm], end = [36 mm, 500 mm])
        left = line(start = [36 mm, 500 mm], end = [36 mm, 0 mm])
    }
    feature cell_2 = extrude(profile = sketch.cell_2_s, distance = input.cell_height)
    sketch cell_3_s on origin.xy {
        front = line(start = [72 mm, 0 mm], end = [106 mm, 0 mm])
        right = line(start = [106 mm, 0 mm], end = [106 mm, 500 mm])
        back = line(start = [106 mm, 500 mm], end = [72 mm, 500 mm])
        left = line(start = [72 mm, 500 mm], end = [72 mm, 0 mm])
    }
    feature cell_3 = extrude(profile = sketch.cell_3_s, distance = input.cell_height)
    sketch cell_4_s on origin.xy {
        front = line(start = [108 mm, 0 mm], end = [142 mm, 0 mm])
        right = line(start = [142 mm, 0 mm], end = [142 mm, 500 mm])
        back = line(start = [142 mm, 500 mm], end = [108 mm, 500 mm])
        left = line(start = [108 mm, 500 mm], end = [108 mm, 0 mm])
    }
    feature cell_4 = extrude(profile = sketch.cell_4_s, distance = input.cell_height)
    sketch cell_5_s on origin.xy {
        front = line(start = [144 mm, 0 mm], end = [178 mm, 0 mm])
        right = line(start = [178 mm, 0 mm], end = [178 mm, 500 mm])
        back = line(start = [178 mm, 500 mm], end = [144 mm, 500 mm])
        left = line(start = [144 mm, 500 mm], end = [144 mm, 0 mm])
    }
    feature cell_5 = extrude(profile = sketch.cell_5_s, distance = input.cell_height)
    sketch cell_6_s on origin.xy {
        front = line(start = [180 mm, 0 mm], end = [214 mm, 0 mm])
        right = line(start = [214 mm, 0 mm], end = [214 mm, 500 mm])
        back = line(start = [214 mm, 500 mm], end = [180 mm, 500 mm])
        left = line(start = [180 mm, 500 mm], end = [180 mm, 0 mm])
    }
    feature cell_6 = extrude(profile = sketch.cell_6_s, distance = input.cell_height)
    sketch cell_7_s on origin.xy {
        front = line(start = [216 mm, 0 mm], end = [250 mm, 0 mm])
        right = line(start = [250 mm, 0 mm], end = [250 mm, 500 mm])
        back = line(start = [250 mm, 500 mm], end = [216 mm, 500 mm])
        left = line(start = [216 mm, 500 mm], end = [216 mm, 0 mm])
    }
    feature cell_7 = extrude(profile = sketch.cell_7_s, distance = input.cell_height)
    sketch cell_8_s on origin.xy {
        front = line(start = [252 mm, 0 mm], end = [286 mm, 0 mm])
        right = line(start = [286 mm, 0 mm], end = [286 mm, 500 mm])
        back = line(start = [286 mm, 500 mm], end = [252 mm, 500 mm])
        left = line(start = [252 mm, 500 mm], end = [252 mm, 0 mm])
    }
    feature cell_8 = extrude(profile = sketch.cell_8_s, distance = input.cell_height)

    // A gap-filler strip under each cell.
    feature pad_plane = plane.offset(base = origin.xy, distance = -input.gap_filler)
    sketch pad_1_s on plane.pad_plane {
        front = line(start = [0 mm, 0 mm], end = [34 mm, 0 mm])
        right = line(start = [34 mm, 0 mm], end = [34 mm, 500 mm])
        back = line(start = [34 mm, 500 mm], end = [0 mm, 500 mm])
        left = line(start = [0 mm, 500 mm], end = [0 mm, 0 mm])
    }
    feature pad_1 = extrude(profile = sketch.pad_1_s, distance = input.gap_filler)
    sketch pad_2_s on plane.pad_plane {
        front = line(start = [36 mm, 0 mm], end = [70 mm, 0 mm])
        right = line(start = [70 mm, 0 mm], end = [70 mm, 500 mm])
        back = line(start = [70 mm, 500 mm], end = [36 mm, 500 mm])
        left = line(start = [36 mm, 500 mm], end = [36 mm, 0 mm])
    }
    feature pad_2 = extrude(profile = sketch.pad_2_s, distance = input.gap_filler)
    sketch pad_3_s on plane.pad_plane {
        front = line(start = [72 mm, 0 mm], end = [106 mm, 0 mm])
        right = line(start = [106 mm, 0 mm], end = [106 mm, 500 mm])
        back = line(start = [106 mm, 500 mm], end = [72 mm, 500 mm])
        left = line(start = [72 mm, 500 mm], end = [72 mm, 0 mm])
    }
    feature pad_3 = extrude(profile = sketch.pad_3_s, distance = input.gap_filler)
    sketch pad_4_s on plane.pad_plane {
        front = line(start = [108 mm, 0 mm], end = [142 mm, 0 mm])
        right = line(start = [142 mm, 0 mm], end = [142 mm, 500 mm])
        back = line(start = [142 mm, 500 mm], end = [108 mm, 500 mm])
        left = line(start = [108 mm, 500 mm], end = [108 mm, 0 mm])
    }
    feature pad_4 = extrude(profile = sketch.pad_4_s, distance = input.gap_filler)
    sketch pad_5_s on plane.pad_plane {
        front = line(start = [144 mm, 0 mm], end = [178 mm, 0 mm])
        right = line(start = [178 mm, 0 mm], end = [178 mm, 500 mm])
        back = line(start = [178 mm, 500 mm], end = [144 mm, 500 mm])
        left = line(start = [144 mm, 500 mm], end = [144 mm, 0 mm])
    }
    feature pad_5 = extrude(profile = sketch.pad_5_s, distance = input.gap_filler)
    sketch pad_6_s on plane.pad_plane {
        front = line(start = [180 mm, 0 mm], end = [214 mm, 0 mm])
        right = line(start = [214 mm, 0 mm], end = [214 mm, 500 mm])
        back = line(start = [214 mm, 500 mm], end = [180 mm, 500 mm])
        left = line(start = [180 mm, 500 mm], end = [180 mm, 0 mm])
    }
    feature pad_6 = extrude(profile = sketch.pad_6_s, distance = input.gap_filler)
    sketch pad_7_s on plane.pad_plane {
        front = line(start = [216 mm, 0 mm], end = [250 mm, 0 mm])
        right = line(start = [250 mm, 0 mm], end = [250 mm, 500 mm])
        back = line(start = [250 mm, 500 mm], end = [216 mm, 500 mm])
        left = line(start = [216 mm, 500 mm], end = [216 mm, 0 mm])
    }
    feature pad_7 = extrude(profile = sketch.pad_7_s, distance = input.gap_filler)
    sketch pad_8_s on plane.pad_plane {
        front = line(start = [252 mm, 0 mm], end = [286 mm, 0 mm])
        right = line(start = [286 mm, 0 mm], end = [286 mm, 500 mm])
        back = line(start = [286 mm, 500 mm], end = [252 mm, 500 mm])
        left = line(start = [252 mm, 500 mm], end = [252 mm, 0 mm])
    }
    feature pad_8 = extrude(profile = sketch.pad_8_s, distance = input.gap_filler)

    // The plate, with its lands under the strips.
    feature plate_plane = plane.offset(base = origin.xy, distance = let.plate_bottom)
    sketch plate_s on plane.plate_plane {
        front = line(start = [-5 mm, -10 mm], end = [291 mm, -10 mm])
        right = line(start = [291 mm, -10 mm], end = [291 mm, input.inlet_y])
        rear = line(start = [291 mm, input.inlet_y], end = [-5 mm, input.inlet_y])
        left = line(start = [-5 mm, input.inlet_y], end = [-5 mm, -10 mm])
    }
    feature plate = extrude(profile = sketch.plate_s, distance = input.plate)
    feature land_plane = plane.offset(base = origin.xy, distance = let.plate_top)
    sketch lands_s on plane.land_plane {
        s1_front = line(start = [0 mm, 0 mm], end = [34 mm, 0 mm])
        s1_right = line(start = [34 mm, 0 mm], end = [34 mm, 500 mm])
        s1_back = line(start = [34 mm, 500 mm], end = [0 mm, 500 mm])
        s1_left = line(start = [0 mm, 500 mm], end = [0 mm, 0 mm])
        s2_front = line(start = [36 mm, 0 mm], end = [70 mm, 0 mm])
        s2_right = line(start = [70 mm, 0 mm], end = [70 mm, 500 mm])
        s2_back = line(start = [70 mm, 500 mm], end = [36 mm, 500 mm])
        s2_left = line(start = [36 mm, 500 mm], end = [36 mm, 0 mm])
        s3_front = line(start = [72 mm, 0 mm], end = [106 mm, 0 mm])
        s3_right = line(start = [106 mm, 0 mm], end = [106 mm, 500 mm])
        s3_back = line(start = [106 mm, 500 mm], end = [72 mm, 500 mm])
        s3_left = line(start = [72 mm, 500 mm], end = [72 mm, 0 mm])
        s4_front = line(start = [108 mm, 0 mm], end = [142 mm, 0 mm])
        s4_right = line(start = [142 mm, 0 mm], end = [142 mm, 500 mm])
        s4_back = line(start = [142 mm, 500 mm], end = [108 mm, 500 mm])
        s4_left = line(start = [108 mm, 500 mm], end = [108 mm, 0 mm])
        s5_front = line(start = [144 mm, 0 mm], end = [178 mm, 0 mm])
        s5_right = line(start = [178 mm, 0 mm], end = [178 mm, 500 mm])
        s5_back = line(start = [178 mm, 500 mm], end = [144 mm, 500 mm])
        s5_left = line(start = [144 mm, 500 mm], end = [144 mm, 0 mm])
        s6_front = line(start = [180 mm, 0 mm], end = [214 mm, 0 mm])
        s6_right = line(start = [214 mm, 0 mm], end = [214 mm, 500 mm])
        s6_back = line(start = [214 mm, 500 mm], end = [180 mm, 500 mm])
        s6_left = line(start = [180 mm, 500 mm], end = [180 mm, 0 mm])
        s7_front = line(start = [216 mm, 0 mm], end = [250 mm, 0 mm])
        s7_right = line(start = [250 mm, 0 mm], end = [250 mm, 500 mm])
        s7_back = line(start = [250 mm, 500 mm], end = [216 mm, 500 mm])
        s7_left = line(start = [216 mm, 500 mm], end = [216 mm, 0 mm])
        s8_front = line(start = [252 mm, 0 mm], end = [286 mm, 0 mm])
        s8_right = line(start = [286 mm, 0 mm], end = [286 mm, 500 mm])
        s8_back = line(start = [286 mm, 500 mm], end = [252 mm, 500 mm])
        s8_left = line(start = [252 mm, 500 mm], end = [252 mm, 0 mm])
    }
    feature lands = extrude(profile = sketch.lands_s, distance = input.land, mode = add(targets = [feature.plate.body]))

    // The coolant: the serpentine, from the inlet's left corner round the outline.
    feature channel_plane = plane.offset(base = origin.xy, distance = let.plate_bottom + input.floor)
    sketch channel_s on plane.channel_plane {
        pass1_out = line(start = [35.75 mm - let.half_w, input.inlet_y], end = [35.75 mm - let.half_w, -let.turn_out])
        turn_a_out = line(start = [35.75 mm - let.half_w, -let.turn_out], end = [107.25 mm + let.half_w, -let.turn_out])
        pass2_out = line(start = [107.25 mm + let.half_w, -let.turn_out], end = [107.25 mm + let.half_w, let.top_in])
        turn_b_in = line(start = [107.25 mm + let.half_w, let.top_in], end = [178.75 mm - let.half_w, let.top_in])
        pass3_out = line(start = [178.75 mm - let.half_w, let.top_in], end = [178.75 mm - let.half_w, -let.turn_out])
        turn_c_out = line(start = [178.75 mm - let.half_w, -let.turn_out], end = [250.25 mm + let.half_w, -let.turn_out])
        pass4_out = line(start = [250.25 mm + let.half_w, -let.turn_out], end = [250.25 mm + let.half_w, input.inlet_y])
        outlet = line(start = [250.25 mm + let.half_w, input.inlet_y], end = [250.25 mm - let.half_w, input.inlet_y])
        pass4_in = line(start = [250.25 mm - let.half_w, input.inlet_y], end = [250.25 mm - let.half_w, let.bottom_in])
        turn_c_in = line(start = [250.25 mm - let.half_w, let.bottom_in], end = [178.75 mm + let.half_w, let.bottom_in])
        pass3_in = line(start = [178.75 mm + let.half_w, let.bottom_in], end = [178.75 mm + let.half_w, let.top_out])
        turn_b_out = line(start = [178.75 mm + let.half_w, let.top_out], end = [107.25 mm - let.half_w, let.top_out])
        pass2_in = line(start = [107.25 mm - let.half_w, let.top_out], end = [107.25 mm - let.half_w, let.bottom_in])
        turn_a_in = line(start = [107.25 mm - let.half_w, let.bottom_in], end = [35.75 mm + let.half_w, let.bottom_in])
        pass1_in = line(start = [35.75 mm + let.half_w, let.bottom_in], end = [35.75 mm + let.half_w, input.inlet_y])
        inlet = line(start = [35.75 mm + let.half_w, input.inlet_y], end = [35.75 mm - let.half_w, input.inlet_y])
    }
    feature channel = extrude(profile = sketch.channel_s, distance = input.channel_depth)
    feature passages = boolean.subtract(target = feature.plate.body, tools = [feature.channel.body], keep_tools = true)

    region coolant_inlet : face = { select = [feature.channel.face.side(channel_s.inlet)], expect = exactly_one, body = feature.channel.body, label = "Coolant inlet" }
    region coolant_outlet : face = { select = [feature.channel.face.side(channel_s.outlet)], expect = exactly_one, body = feature.channel.body, label = "Coolant outlet" }
    region channel_wall : face = { select = [feature.channel.face.side(channel_s.pass1_out), feature.channel.face.side(channel_s.turn_a_out), feature.channel.face.side(channel_s.pass2_out), feature.channel.face.side(channel_s.turn_b_in), feature.channel.face.side(channel_s.pass3_out), feature.channel.face.side(channel_s.turn_c_out), feature.channel.face.side(channel_s.pass4_out), feature.channel.face.side(channel_s.pass4_in), feature.channel.face.side(channel_s.turn_c_in), feature.channel.face.side(channel_s.pass3_in), feature.channel.face.side(channel_s.turn_b_out), feature.channel.face.side(channel_s.pass2_in), feature.channel.face.side(channel_s.turn_a_in), feature.channel.face.side(channel_s.pass1_in), feature.channel.face.start, feature.channel.face.end], expect = at_least_one, body = feature.channel.body, label = "Channel wall" }
    region plate_channel_wall : face = { select = [feature.channel.face.side(channel_s.pass1_out), feature.channel.face.side(channel_s.turn_a_out), feature.channel.face.side(channel_s.pass2_out), feature.channel.face.side(channel_s.turn_b_in), feature.channel.face.side(channel_s.pass3_out), feature.channel.face.side(channel_s.turn_c_out), feature.channel.face.side(channel_s.pass4_out), feature.channel.face.side(channel_s.pass4_in), feature.channel.face.side(channel_s.turn_c_in), feature.channel.face.side(channel_s.pass3_in), feature.channel.face.side(channel_s.turn_b_out), feature.channel.face.side(channel_s.pass2_in), feature.channel.face.side(channel_s.turn_a_in), feature.channel.face.side(channel_s.pass1_in), feature.channel.face.start, feature.channel.face.end], expect = at_least_one, body = feature.plate.body, label = "Plate channel wall" }
    region cell_bottoms : face = { select = [feature.cell_1.face.start, feature.cell_2.face.start, feature.cell_3.face.start, feature.cell_4.face.start, feature.cell_5.face.start, feature.cell_6.face.start, feature.cell_7.face.start, feature.cell_8.face.start], expect = at_least_one, label = "M01 cell bottom" }

    output cell_1 = { body = feature.cell_1.body, label = "M01 cell 1", material = "li_ion_prismatic", color = "#2F5D8A" }
    output cell_2 = { body = feature.cell_2.body, label = "M01 cell 2", material = "li_ion_prismatic", color = "#2F5D8A" }
    output cell_3 = { body = feature.cell_3.body, label = "M01 cell 3", material = "li_ion_prismatic", color = "#2F5D8A" }
    output cell_4 = { body = feature.cell_4.body, label = "M01 cell 4", material = "li_ion_prismatic", color = "#2F5D8A" }
    output cell_5 = { body = feature.cell_5.body, label = "M01 cell 5", material = "li_ion_prismatic", color = "#2F5D8A" }
    output cell_6 = { body = feature.cell_6.body, label = "M01 cell 6", material = "li_ion_prismatic", color = "#2F5D8A" }
    output cell_7 = { body = feature.cell_7.body, label = "M01 cell 7", material = "li_ion_prismatic", color = "#2F5D8A" }
    output cell_8 = { body = feature.cell_8.body, label = "M01 cell 8", material = "li_ion_prismatic", color = "#2F5D8A" }
    output pad_1 = { body = feature.pad_1.body, label = "Gap filler", material = "gap_filler_3w", color = "#E0B43C" }
    output pad_2 = { body = feature.pad_2.body, label = "Gap filler", material = "gap_filler_3w", color = "#E0B43C" }
    output pad_3 = { body = feature.pad_3.body, label = "Gap filler", material = "gap_filler_3w", color = "#E0B43C" }
    output pad_4 = { body = feature.pad_4.body, label = "Gap filler", material = "gap_filler_3w", color = "#E0B43C" }
    output pad_5 = { body = feature.pad_5.body, label = "Gap filler", material = "gap_filler_3w", color = "#E0B43C" }
    output pad_6 = { body = feature.pad_6.body, label = "Gap filler", material = "gap_filler_3w", color = "#E0B43C" }
    output pad_7 = { body = feature.pad_7.body, label = "Gap filler", material = "gap_filler_3w", color = "#E0B43C" }
    output pad_8 = { body = feature.pad_8.body, label = "Gap filler", material = "gap_filler_3w", color = "#E0B43C" }
    output cold_plate = { body = feature.plate.body, label = "Cold plate", part_number = "M01-CP-01", material = "aluminum_3003", color = "#B9BFC7" }
    output coolant = { body = feature.channel.body, label = "Coolant", color = "#3C8DD8" }
}
