        t22_root = line(start = [38.8112 mm, -18.5120 mm], end = [40.5336 mm, -14.3537 mm])
        t23_fa = line(start = [40.5336 mm, -14.3537 mm], end = [45.4526 mm, -15.4291 mm])
        t23_fb = line(start = [45.4526 mm, -15.4291 mm], end = [49.6408 mm, -15.4852 mm])
        t23_tip = line(start = [49.6408 mm, -15.4852 mm], end = [50.7328 mm, -11.4099 mm])
        t23_fc = line(start = [50.7328 mm, -11.4099 mm], end = [47.0777 mm, -9.3643 mm])
        t23_fd = line(start = [47.0777 mm, -9.3643 mm], end = [42.2800 mm, -7.8361 mm])
        t23_root = line(start = [42.2800 mm, -7.8361 mm], end = [42.8674 mm, -3.3737 mm])
        bore = circle(center = [0 mm, 0 mm], radius = input.bore / 2)
    }
    feature gear = extrude(profile = sketch.gear_s, distance = input.face_width)

    feature coil_plane = plane.offset(base = origin.xy, distance = (input.face_width - input.coil_height) / 2)
    sketch coil_s on plane.coil_plane {
        lead_in_top = line(start = [150.0000 mm, 9.0000 mm], end = [61.3433 mm, 9.0000 mm])
        outer = arc(center = [0 mm, 0 mm], start = [61.3433 mm, 9.0000 mm], end = [61.3433 mm, -9.0000 mm])
        lead_out_bottom = line(start = [61.3433 mm, -9.0000 mm], end = [150.0000 mm, -9.0000 mm])
        lead_out_end = line(start = [150.0000 mm, -9.0000 mm], end = [150.0000 mm, -3.0000 mm])
        lead_out_top = line(start = [150.0000 mm, -3.0000 mm], end = [55.9196 mm, -3.0000 mm])
        inner = arc(center = [0 mm, 0 mm], start = [55.9196 mm, 3.0000 mm], end = [55.9196 mm, -3.0000 mm])
        lead_in_bottom = line(start = [55.9196 mm, 3.0000 mm], end = [150.0000 mm, 3.0000 mm])
        lead_in_end = line(start = [150.0000 mm, 3.0000 mm], end = [150.0000 mm, 9.0000 mm])
    }
    feature coil = extrude(profile = sketch.coil_s, distance = input.coil_height)

    feature air_plane = plane.offset(base = origin.xy, distance = -input.air_below)
    sketch air_s on plane.air_plane {
        front = line(start = [-150 mm, -150 mm], end = [150 mm, -150 mm])
        right = line(start = [150 mm, -150 mm], end = [150 mm, 150 mm])
        back = line(start = [150 mm, 150 mm], end = [-150 mm, 150 mm])
        left = line(start = [-150 mm, 150 mm], end = [-150 mm, -150 mm])
    }
    feature air = extrude(profile = sketch.air_s, distance = input.air_height)
    feature surround = boolean.subtract(target = feature.air.body, tools = [feature.gear.body, feature.coil.body], keep_tools = true)

    region coil_in : face = { select = [feature.coil.face.side(coil_s.lead_in_end)], expect = exactly_one, body = feature.coil.body, label = "Coil in" }
    region coil_out : face = { select = [feature.coil.face.side(coil_s.lead_out_end)], expect = exactly_one, body = feature.coil.body, label = "Coil out" }
    region outer_boundary : face = {
        select = [
            feature.air.face.start,
            feature.air.face.end,
            feature.air.face.side(air_s.front),
            feature.air.face.side(air_s.right),
            feature.air.face.side(air_s.back),
            feature.air.face.side(air_s.left)
        ],
        expect = at_least_one,
        body = feature.air.body,
        label = "Outer boundary"
    }

    output gear = { body = feature.gear.body, label = "Gear", part_number = "SG-M4-24", material = "steel_42crmo4", color = "#9AA3AD" }
    output coil = { body = feature.coil.body, label = "Coil", material = "copper_c11000", color = "#C8794A" }
    output air = { body = feature.air.body, label = "Air", color = "#CFE3F533" }
}
