runmat 0.7
std 1

// A helical static mixer in a 20 mm tube: 6 elements, each a 1.5 mm plate twisted 180 degrees over
// 30 mm (1.5 diameters), alternately right- and left-handed and turned 90 degrees to the one
// before, so each element splits the stream its neighbour delivers. A straight splitter
// plate ahead of the first element keeps the two feeds apart until they reach it: stream A
// enters through an 8 mm side port above it ("Inlet A") and stream B through one below
// ("Inlet B").
// Laminar sizing: 2 L/min of a 0.1 Pa s, 1100 kg/m^3 resin in the 20 mm bore is 0.106 m/s,
// Re = 23; static mixers of this kind are sized for Re under about 100.
// Generated by gen_mixer.py (element count, length, plate and bore); edit there and re-run it.
part mixer {
    input bore : length = 20 mm
    input inlet_length : length = 20 mm
    input outlet_length : length = 40 mm
    input port : length = 8 mm
    input port_length : length = 15 mm

    sketch splitter_s on origin.xy {
        a = line(start = [-11.0000 mm, -0.7500 mm], end = [11.0000 mm, -0.7500 mm])
        b = line(start = [11.0000 mm, -0.7500 mm], end = [11.0000 mm, 0.7500 mm])
        c = line(start = [11.0000 mm, 0.7500 mm], end = [-11.0000 mm, 0.7500 mm])
        d = line(start = [-11.0000 mm, 0.7500 mm], end = [-11.0000 mm, -0.7500 mm])
    }
    feature splitter = extrude(profile = sketch.splitter_s, distance = input.inlet_length)

    // The elements, lofted through sections every 30 degrees of twist.
    feature e0_s0_p = plane.offset(base = origin.xy, distance = 20.0000 mm)
    sketch e0_s0 on plane.e0_s0_p {
