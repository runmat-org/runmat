    }
    feature e5_s2_p = plane.offset(base = origin.xy, distance = 180.0000 mm)
    sketch e5_s2 on plane.e5_s2_p {
        c = spline(points = [[-8.5018 mm, -5.7745 mm], [-4.3881 mm, -3.3995 mm], [0.3750 mm, -0.6495 mm], [5.1381 mm, 2.1005 mm], [9.2518 mm, 4.4755 mm], [9.6012 mm, 4.9309 mm], [9.5263 mm, 5.5000 mm], [9.0709 mm, 5.8494 mm], [8.5018 mm, 5.7745 mm], [4.3881 mm, 3.3995 mm], [-0.3750 mm, 0.6495 mm], [-5.1381 mm, -2.1005 mm], [-9.2518 mm, -4.4755 mm], [-9.6012 mm, -4.9309 mm], [-9.5263 mm, -5.5000 mm], [-9.0709 mm, -5.8494 mm]], closed)
