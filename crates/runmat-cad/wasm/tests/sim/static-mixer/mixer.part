    }
    feature e5_s6_p = plane.offset(base = origin.xy, distance = 200.0000 mm)
    sketch e5_s6 on plane.e5_s6_p {
        c = spline(points = [[-0.7500 mm, 10.2500 mm], [-0.7500 mm, 5.5000 mm], [-0.7500 mm, 0.0000 mm], [-0.7500 mm, -5.5000 mm], [-0.7500 mm, -10.2500 mm], [-0.5303 mm, -10.7803 mm], [-0.0000 mm, -11.0000 mm], [0.5303 mm, -10.7803 mm], [0.7500 mm, -10.2500 mm], [0.7500 mm, -5.5000 mm], [0.7500 mm, -0.0000 mm], [0.7500 mm, 5.5000 mm], [0.7500 mm, 10.2500 mm], [0.5303 mm, 10.7803 mm], [0.0000 mm, 11.0000 mm], [-0.5303 mm, 10.7803 mm]], closed)
    }
    feature element_1 = loft(profiles = [sketch.e0_s0, sketch.e0_s1, sketch.e0_s2, sketch.e0_s3, sketch.e0_s4, sketch.e0_s5, sketch.e0_s6])
    feature element_2 = loft(profiles = [sketch.e1_s0, sketch.e1_s1, sketch.e1_s2, sketch.e1_s3, sketch.e1_s4, sketch.e1_s5, sketch.e1_s6])
    feature element_3 = loft(profiles = [sketch.e2_s0, sketch.e2_s1, sketch.e2_s2, sketch.e2_s3, sketch.e2_s4, sketch.e2_s5, sketch.e2_s6])
    feature element_4 = loft(profiles = [sketch.e3_s0, sketch.e3_s1, sketch.e3_s2, sketch.e3_s3, sketch.e3_s4, sketch.e3_s5, sketch.e3_s6])
    feature element_5 = loft(profiles = [sketch.e4_s0, sketch.e4_s1, sketch.e4_s2, sketch.e4_s3, sketch.e4_s4, sketch.e4_s5, sketch.e4_s6])
    feature element_6 = loft(profiles = [sketch.e5_s0, sketch.e5_s1, sketch.e5_s2, sketch.e5_s3, sketch.e5_s4, sketch.e5_s5, sketch.e5_s6])
    feature insert = boolean.union(target = feature.splitter.body, tools = [feature.element_1.body, feature.element_2.body, feature.element_3.body, feature.element_4.body, feature.element_5.body, feature.element_6.body])

    // The plates are cut a little wide and trimmed to the bore, so their edges lie on the wall.
    sketch sleeve_s on origin.xy {
        outside = circle(center = [0 mm, 0 mm], radius = input.bore / 2 + 4 mm)
        bore = circle(center = [0 mm, 0 mm], radius = input.bore / 2)
    }
    feature sleeve = extrude(profile = sketch.sleeve_s, distance = input.inlet_length + 180 mm + input.outlet_length)
    feature trim = boolean.subtract(target = feature.splitter.body, tools = [feature.sleeve.body])

    // The fluid: the tube with its two side ports, less the mixer.
    sketch tube_s on origin.xy {
        bore = circle(center = [0 mm, 0 mm], radius = input.bore / 2)
    }
    feature tube = extrude(profile = sketch.tube_s, distance = input.inlet_length + 180 mm + input.outlet_length)
    feature port_a_p = plane.offset(base = origin.zx, distance = input.bore / 2 - 1 mm)
    sketch port_a_s on plane.port_a_p {
        bore = circle(center = [input.inlet_length / 2, 0 mm], radius = input.port / 2)
    }
    feature port_a = extrude(profile = sketch.port_a_s, distance = input.port_length + 1 mm, mode = add(targets = [feature.tube.body]))
    feature port_b_p = plane.offset(base = origin.zx, distance = -input.bore / 2 - input.port_length)
    sketch port_b_s on plane.port_b_p {
        bore = circle(center = [input.inlet_length / 2, 0 mm], radius = input.port / 2)
    }
    feature port_b = extrude(profile = sketch.port_b_s, distance = input.port_length + 1 mm, mode = add(targets = [feature.tube.body]))
    feature fluid = boolean.subtract(target = feature.tube.body, tools = [feature.splitter.body], keep_tools = true)

    region inlet_a : face = { select = [feature.port_a.face.end], expect = exactly_one, label = "Inlet A" }
    region inlet_b : face = { select = [feature.port_b.face.start], expect = exactly_one, label = "Inlet B" }
    region outlet : face = { select = [feature.tube.face.end], expect = exactly_one, label = "Outlet" }
    region wall : face = {
        select = [feature.tube.face.side(tube_s.bore), feature.tube.face.start, feature.port_a.face.side(port_a_s.bore), feature.port_b.face.side(port_b_s.bore)],
        expect = at_least_one,
        label = "Wall"
    }

    output fluid = { body = feature.tube.body, label = "Fluid", color = "#7FB7E6" }
    output mixer = { body = feature.element_1.body, label = "Mixer", part_number = "SM-20-6", material = "stainless_316l", color = "#9AA3AD" }
}
