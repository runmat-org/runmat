runmat 0.7
std 1

// A thin steel guide rail, 500 x 20 x 3 mm (S235 flat bar), clamped at both ends so it cannot
// grow when it warms. A restrained bar buckles once its thermal strain reaches the Euler strain:
// for clamped ends, alpha dT = 4 pi^2 I / (A L^2) = pi^2 t^2 / (3 L^2), so
// dT_cr = pi^2 x (3 mm)^2 / (3 x (500 mm)^2 x 12e-6 /K) = 9.9 K.
// Change `length` or `thickness` and re-run the study: the critical rise goes as (t / L)^2.
part rail {
    input length : length = 500 mm
    input width : length = 20 mm
    input thickness : length = 3 mm
    input edge_break : length = 0.5 mm

    sketch bar_s on origin.yz {
        bottom = line(start = [0 mm, 0 mm], end = [input.width, 0 mm])
        right = line(start = [input.width, 0 mm], end = [input.width, input.thickness])
        top = line(start = [input.width, input.thickness], end = [0 mm, input.thickness])
        left = line(start = [0 mm, input.thickness], end = [0 mm, 0 mm])
    }
    feature bar = extrude(profile = sketch.bar_s, distance = input.length)
    feature edges = chamfer(
        edges = [
            edges_between(feature.bar.face.side(bar_s.top), feature.bar.face.side(bar_s.left)),
            edges_between(feature.bar.face.side(bar_s.top), feature.bar.face.side(bar_s.right))
        ],
        distance = input.edge_break
    )

    region end_a : face = { select = [feature.bar.face.start], expect = exactly_one, label = "End A" }
    region end_b : face = { select = [feature.bar.face.end], expect = exactly_one, label = "End B" }

    output rail = { body = feature.bar.body, label = "Rail", part_number = "GR-0520", material = "steel_s235", color = "#9AA3AD" }
}
