        v27_c = line(start = [2.5000 mm, -148.0000 mm], end = [2.5000 mm, -95.0000 mm])
        v27_d = line(start = [2.5000 mm, -95.0000 mm], end = [-2.5000 mm, -95.0000 mm])
        v28_a = line(start = [14.0346 mm, -93.9909 mm], end = [23.2379 mm, -146.1857 mm])
