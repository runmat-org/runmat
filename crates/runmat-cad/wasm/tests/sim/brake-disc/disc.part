        v11_a = line(start = [-30.1427 mm, 90.1258 mm], end = [-48.2697 mm, 139.9296 mm])
        v11_b = line(start = [-48.2697 mm, 139.9296 mm], end = [-52.9682 mm, 138.2195 mm])
        v11_c = line(start = [-52.9682 mm, 138.2195 mm], end = [-34.8411 mm, 88.4157 mm])
        v11_d = line(start = [-34.8411 mm, 88.4157 mm], end = [-30.1427 mm, 90.1258 mm])
        v12_a = line(start = [-45.3349 mm, 83.5224 mm], end = [-71.8349 mm, 129.4218 mm])
        v12_b = line(start = [-71.8349 mm, 129.4218 mm], end = [-76.1651 mm, 126.9218 mm])
        v12_c = line(start = [-76.1651 mm, 126.9218 mm], end = [-49.6651 mm, 81.0224 mm])
        v12_d = line(start = [-49.6651 mm, 81.0224 mm], end = [-45.3349 mm, 83.5224 mm])
        v13_a = line(start = [-59.1497 mm, 74.3812 mm], end = [-93.2175 mm, 114.9815 mm])
        v13_b = line(start = [-93.2175 mm, 114.9815 mm], end = [-97.0477 mm, 111.7676 mm])
        v13_c = line(start = [-97.0477 mm, 111.7676 mm], end = [-62.9799 mm, 71.1673 mm])
        v13_d = line(start = [-62.9799 mm, 71.1673 mm], end = [-59.1497 mm, 74.3812 mm])
        v14_a = line(start = [-71.1673 mm, 62.9799 mm], end = [-111.7676 mm, 97.0477 mm])
        v14_b = line(start = [-111.7676 mm, 97.0477 mm], end = [-114.9815 mm, 93.2175 mm])
        v14_c = line(start = [-114.9815 mm, 93.2175 mm], end = [-74.3812 mm, 59.1497 mm])
        v14_d = line(start = [-74.3812 mm, 59.1497 mm], end = [-71.1673 mm, 62.9799 mm])
        v15_a = line(start = [-81.0224 mm, 49.6651 mm], end = [-126.9218 mm, 76.1651 mm])
        v15_b = line(start = [-126.9218 mm, 76.1651 mm], end = [-129.4218 mm, 71.8349 mm])
        v15_c = line(start = [-129.4218 mm, 71.8349 mm], end = [-83.5224 mm, 45.3349 mm])
        v15_d = line(start = [-83.5224 mm, 45.3349 mm], end = [-81.0224 mm, 49.6651 mm])
        v16_a = line(start = [-88.4157 mm, 34.8411 mm], end = [-138.2195 mm, 52.9682 mm])
