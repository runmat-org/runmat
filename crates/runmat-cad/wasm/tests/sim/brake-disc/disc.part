        v19_c = line(start = [-145.3174 mm, -28.1619 mm], end = [-93.1226 mm, -18.9586 mm])
        v19_d = line(start = [-93.1226 mm, -18.9586 mm], end = [-93.9909 mm, -14.0346 mm])
        v20_a = line(start = [-90.1258 mm, -30.1427 mm], end = [-139.9296 mm, -48.2697 mm])
