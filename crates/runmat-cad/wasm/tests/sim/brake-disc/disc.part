        v21_c = line(start = [-126.9218 mm, -76.1651 mm], end = [-81.0224 mm, -49.6651 mm])
        v21_d = line(start = [-81.0224 mm, -49.6651 mm], end = [-83.5224 mm, -45.3349 mm])
        v22_a = line(start = [-74.3812 mm, -59.1497 mm], end = [-114.9815 mm, -93.2175 mm])
        v22_b = line(start = [-114.9815 mm, -93.2175 mm], end = [-111.7676 mm, -97.0477 mm])
        v22_c = line(start = [-111.7676 mm, -97.0477 mm], end = [-71.1673 mm, -62.9799 mm])
        v22_d = line(start = [-71.1673 mm, -62.9799 mm], end = [-74.3812 mm, -59.1497 mm])
        v23_a = line(start = [-62.9799 mm, -71.1673 mm], end = [-97.0477 mm, -111.7676 mm])
        v23_b = line(start = [-97.0477 mm, -111.7676 mm], end = [-93.2175 mm, -114.9815 mm])
        v23_c = line(start = [-93.2175 mm, -114.9815 mm], end = [-59.1497 mm, -74.3812 mm])
        v23_d = line(start = [-59.1497 mm, -74.3812 mm], end = [-62.9799 mm, -71.1673 mm])
        v24_a = line(start = [-49.6651 mm, -81.0224 mm], end = [-76.1651 mm, -126.9218 mm])
        v24_b = line(start = [-76.1651 mm, -126.9218 mm], end = [-71.8349 mm, -129.4218 mm])
        v24_c = line(start = [-71.8349 mm, -129.4218 mm], end = [-45.3349 mm, -83.5224 mm])
        v24_d = line(start = [-45.3349 mm, -83.5224 mm], end = [-49.6651 mm, -81.0224 mm])
        v25_a = line(start = [-34.8411 mm, -88.4157 mm], end = [-52.9682 mm, -138.2195 mm])
        v25_b = line(start = [-52.9682 mm, -138.2195 mm], end = [-48.2697 mm, -139.9296 mm])
        v25_c = line(start = [-48.2697 mm, -139.9296 mm], end = [-30.1427 mm, -90.1258 mm])
        v25_d = line(start = [-30.1427 mm, -90.1258 mm], end = [-34.8411 mm, -88.4157 mm])
        v26_a = line(start = [-18.9586 mm, -93.1226 mm], end = [-28.1619 mm, -145.3174 mm])
        v26_b = line(start = [-28.1619 mm, -145.3174 mm], end = [-23.2379 mm, -146.1857 mm])
        v26_c = line(start = [-23.2379 mm, -146.1857 mm], end = [-14.0346 mm, -93.9909 mm])
        v26_d = line(start = [-14.0346 mm, -93.9909 mm], end = [-18.9586 mm, -93.1226 mm])
        v27_a = line(start = [-2.5000 mm, -95.0000 mm], end = [-2.5000 mm, -148.0000 mm])
