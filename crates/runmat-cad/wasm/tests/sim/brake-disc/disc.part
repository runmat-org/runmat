        v8_a = line(start = [18.9586 mm, 93.1226 mm], end = [28.1619 mm, 145.3174 mm])
        v8_b = line(start = [28.1619 mm, 145.3174 mm], end = [23.2379 mm, 146.1857 mm])
        v8_c = line(start = [23.2379 mm, 146.1857 mm], end = [14.0346 mm, 93.9909 mm])
        v8_d = line(start = [14.0346 mm, 93.9909 mm], end = [18.9586 mm, 93.1226 mm])
        v9_a = line(start = [2.5000 mm, 95.0000 mm], end = [2.5000 mm, 148.0000 mm])
        v9_b = line(start = [2.5000 mm, 148.0000 mm], end = [-2.5000 mm, 148.0000 mm])
        v9_c = line(start = [-2.5000 mm, 148.0000 mm], end = [-2.5000 mm, 95.0000 mm])
        v9_d = line(start = [-2.5000 mm, 95.0000 mm], end = [2.5000 mm, 95.0000 mm])
        v10_a = line(start = [-14.0346 mm, 93.9909 mm], end = [-23.2379 mm, 146.1857 mm])
        v10_b = line(start = [-23.2379 mm, 146.1857 mm], end = [-28.1619 mm, 145.3174 mm])
