runmat 0.7
std 1

// The oil in a hydraulic return-line filter and its pleated cartridge. The bowl is 120 mm
// across and 150 mm tall inside; the oil comes in through a 20 mm side port near the top,
// passes in through the pleated media ("Media", a porous body, 24 pleats of 1.5 mm media from
// 22 to 45 mm radius over the bowl's full height, sealed at both ends by the bowl), and
// leaves down the cartridge's core through a 20 mm port in the floor.
// Laminar sizing at 20 L/min of ISO VG 46 oil at 40 degC (46 cSt): 1.06 m/s in the 20 mm
// ports, Re = 461. The media's 0.168 m^2 sees 2.0 mm/s.
// Generated by gen_filter.py (pleat count, radii and media thickness); edit there and re-run it.
part filter {
    input bowl : length = 120 mm
    input height : length = 150 mm
    input port : length = 20 mm
    input port_height : length = 120 mm
    input port_length : length = 40 mm

    sketch bowl_s on origin.xy {
        wall = circle(center = [0 mm, 0 mm], radius = input.bowl / 2)
    }
    feature bowl = extrude(profile = sketch.bowl_s, distance = input.height)

    feature inlet_plane = plane.offset(base = origin.yz, distance = input.bowl / 2 - 5 mm)
    sketch inlet_s on plane.inlet_plane {
        pipe = circle(center = [0 mm, input.port_height], radius = input.port / 2)
    }
    feature inlet = extrude(profile = sketch.inlet_s, distance = input.port_length + 5 mm, mode = add(targets = [feature.bowl.body]))

    feature outlet_plane = plane.offset(base = origin.xy, distance = -input.port_length)
    sketch outlet_s on plane.outlet_plane {
        pipe = circle(center = [0 mm, 0 mm], radius = input.port / 2)
    }
    sketch media_s on origin.xy {
        o0 = line(start = [51.1026 mm, 0.0000 mm], end = [24.7697 mm, 3.2610 mm])
        o1 = line(start = [24.7697 mm, 3.2610 mm], end = [49.3613 mm, 13.2263 mm])
        o2 = line(start = [49.3613 mm, 13.2263 mm], end = [23.0817 mm, 9.5608 mm])
        o3 = line(start = [23.0817 mm, 9.5608 mm], end = [44.2561 mm, 25.5513 mm])
        o4 = line(start = [44.2561 mm, 25.5513 mm], end = [19.8207 mm, 15.2090 mm])
        o5 = line(start = [19.8207 mm, 15.2090 mm], end = [36.1350 mm, 36.1350 mm])
        o6 = line(start = [36.1350 mm, 36.1350 mm], end = [15.2090 mm, 19.8207 mm])
        o7 = line(start = [15.2090 mm, 19.8207 mm], end = [25.5513 mm, 44.2561 mm])
        o8 = line(start = [25.5513 mm, 44.2561 mm], end = [9.5608 mm, 23.0817 mm])
        o9 = line(start = [9.5608 mm, 23.0817 mm], end = [13.2263 mm, 49.3613 mm])
        o10 = line(start = [13.2263 mm, 49.3613 mm], end = [3.2610 mm, 24.7697 mm])
        o11 = line(start = [3.2610 mm, 24.7697 mm], end = [0.0000 mm, 51.1026 mm])
        o12 = line(start = [0.0000 mm, 51.1026 mm], end = [-3.2610 mm, 24.7697 mm])
        o13 = line(start = [-3.2610 mm, 24.7697 mm], end = [-13.2263 mm, 49.3613 mm])
        o14 = line(start = [-13.2263 mm, 49.3613 mm], end = [-9.5608 mm, 23.0817 mm])
        o15 = line(start = [-9.5608 mm, 23.0817 mm], end = [-25.5513 mm, 44.2561 mm])
        o16 = line(start = [-25.5513 mm, 44.2561 mm], end = [-15.2090 mm, 19.8207 mm])
        o17 = line(start = [-15.2090 mm, 19.8207 mm], end = [-36.1350 mm, 36.1350 mm])
        o18 = line(start = [-36.1350 mm, 36.1350 mm], end = [-19.8207 mm, 15.2090 mm])
        o19 = line(start = [-19.8207 mm, 15.2090 mm], end = [-44.2561 mm, 25.5513 mm])
        o20 = line(start = [-44.2561 mm, 25.5513 mm], end = [-23.0817 mm, 9.5608 mm])
        o21 = line(start = [-23.0817 mm, 9.5608 mm], end = [-49.3613 mm, 13.2263 mm])
        o22 = line(start = [-49.3613 mm, 13.2263 mm], end = [-24.7697 mm, 3.2610 mm])
        o23 = line(start = [-24.7697 mm, 3.2610 mm], end = [-51.1026 mm, 0.0000 mm])
        o24 = line(start = [-51.1026 mm, 0.0000 mm], end = [-24.7697 mm, -3.2610 mm])
        o25 = line(start = [-24.7697 mm, -3.2610 mm], end = [-49.3613 mm, -13.2263 mm])
        o26 = line(start = [-49.3613 mm, -13.2263 mm], end = [-23.0817 mm, -9.5608 mm])
        o27 = line(start = [-23.0817 mm, -9.5608 mm], end = [-44.2561 mm, -25.5513 mm])
        o28 = line(start = [-44.2561 mm, -25.5513 mm], end = [-19.8207 mm, -15.2090 mm])
        o29 = line(start = [-19.8207 mm, -15.2090 mm], end = [-36.1350 mm, -36.1350 mm])
        o30 = line(start = [-36.1350 mm, -36.1350 mm], end = [-15.2090 mm, -19.8207 mm])
        o31 = line(start = [-15.2090 mm, -19.8207 mm], end = [-25.5513 mm, -44.2561 mm])
        o32 = line(start = [-25.5513 mm, -44.2561 mm], end = [-9.5608 mm, -23.0817 mm])
        o33 = line(start = [-9.5608 mm, -23.0817 mm], end = [-13.2263 mm, -49.3613 mm])
        o34 = line(start = [-13.2263 mm, -49.3613 mm], end = [-3.2610 mm, -24.7697 mm])
        o35 = line(start = [-3.2610 mm, -24.7697 mm], end = [-0.0000 mm, -51.1026 mm])
        o36 = line(start = [-0.0000 mm, -51.1026 mm], end = [3.2610 mm, -24.7697 mm])
        o37 = line(start = [3.2610 mm, -24.7697 mm], end = [13.2263 mm, -49.3613 mm])
        o38 = line(start = [13.2263 mm, -49.3613 mm], end = [9.5608 mm, -23.0817 mm])
        o39 = line(start = [9.5608 mm, -23.0817 mm], end = [25.5513 mm, -44.2561 mm])
        o40 = line(start = [25.5513 mm, -44.2561 mm], end = [15.2090 mm, -19.8207 mm])
        o41 = line(start = [15.2090 mm, -19.8207 mm], end = [36.1350 mm, -36.1350 mm])
        o42 = line(start = [36.1350 mm, -36.1350 mm], end = [19.8207 mm, -15.2090 mm])
        o43 = line(start = [19.8207 mm, -15.2090 mm], end = [44.2561 mm, -25.5513 mm])
        o44 = line(start = [44.2561 mm, -25.5513 mm], end = [23.0817 mm, -9.5608 mm])
        o45 = line(start = [23.0817 mm, -9.5608 mm], end = [49.3613 mm, -13.2263 mm])
        o46 = line(start = [49.3613 mm, -13.2263 mm], end = [24.7697 mm, -3.2610 mm])
        o47 = line(start = [24.7697 mm, -3.2610 mm], end = [51.1026 mm, 0.0000 mm])
        i0 = line(start = [38.8974 mm, 0.0000 mm], end = [18.8538 mm, 2.4822 mm])
        i1 = line(start = [18.8538 mm, 2.4822 mm], end = [37.5720 mm, 10.0674 mm])
        i2 = line(start = [37.5720 mm, 10.0674 mm], end = [17.5690 mm, 7.2773 mm])
        i3 = line(start = [17.5690 mm, 7.2773 mm], end = [33.6862 mm, 19.4487 mm])
        i4 = line(start = [33.6862 mm, 19.4487 mm], end = [15.0868 mm, 11.5765 mm])
        i5 = line(start = [15.0868 mm, 11.5765 mm], end = [27.5046 mm, 27.5046 mm])
        i6 = line(start = [27.5046 mm, 27.5046 mm], end = [11.5765 mm, 15.0868 mm])
        i7 = line(start = [11.5765 mm, 15.0868 mm], end = [19.4487 mm, 33.6862 mm])
        i8 = line(start = [19.4487 mm, 33.6862 mm], end = [7.2773 mm, 17.5690 mm])
        i9 = line(start = [7.2773 mm, 17.5690 mm], end = [10.0674 mm, 37.5720 mm])
        i10 = line(start = [10.0674 mm, 37.5720 mm], end = [2.4822 mm, 18.8538 mm])
        i11 = line(start = [2.4822 mm, 18.8538 mm], end = [0.0000 mm, 38.8974 mm])
        i12 = line(start = [0.0000 mm, 38.8974 mm], end = [-2.4822 mm, 18.8538 mm])
        i13 = line(start = [-2.4822 mm, 18.8538 mm], end = [-10.0674 mm, 37.5720 mm])
        i14 = line(start = [-10.0674 mm, 37.5720 mm], end = [-7.2773 mm, 17.5690 mm])
        i15 = line(start = [-7.2773 mm, 17.5690 mm], end = [-19.4487 mm, 33.6862 mm])
        i16 = line(start = [-19.4487 mm, 33.6862 mm], end = [-11.5765 mm, 15.0868 mm])
        i17 = line(start = [-11.5765 mm, 15.0868 mm], end = [-27.5046 mm, 27.5046 mm])
        i18 = line(start = [-27.5046 mm, 27.5046 mm], end = [-15.0868 mm, 11.5765 mm])
        i19 = line(start = [-15.0868 mm, 11.5765 mm], end = [-33.6862 mm, 19.4487 mm])
        i20 = line(start = [-33.6862 mm, 19.4487 mm], end = [-17.5690 mm, 7.2773 mm])
        i21 = line(start = [-17.5690 mm, 7.2773 mm], end = [-37.5720 mm, 10.0674 mm])
        i22 = line(start = [-37.5720 mm, 10.0674 mm], end = [-18.8538 mm, 2.4822 mm])
        i23 = line(start = [-18.8538 mm, 2.4822 mm], end = [-38.8974 mm, 0.0000 mm])
        i24 = line(start = [-38.8974 mm, 0.0000 mm], end = [-18.8538 mm, -2.4822 mm])
        i25 = line(start = [-18.8538 mm, -2.4822 mm], end = [-37.5720 mm, -10.0674 mm])
        i26 = line(start = [-37.5720 mm, -10.0674 mm], end = [-17.5690 mm, -7.2773 mm])
        i27 = line(start = [-17.5690 mm, -7.2773 mm], end = [-33.6862 mm, -19.4487 mm])
        i28 = line(start = [-33.6862 mm, -19.4487 mm], end = [-15.0868 mm, -11.5765 mm])
        i29 = line(start = [-15.0868 mm, -11.5765 mm], end = [-27.5046 mm, -27.5046 mm])
        i30 = line(start = [-27.5046 mm, -27.5046 mm], end = [-11.5765 mm, -15.0868 mm])
        i31 = line(start = [-11.5765 mm, -15.0868 mm], end = [-19.4487 mm, -33.6862 mm])
        i32 = line(start = [-19.4487 mm, -33.6862 mm], end = [-7.2773 mm, -17.5690 mm])
        i33 = line(start = [-7.2773 mm, -17.5690 mm], end = [-10.0674 mm, -37.5720 mm])
        i34 = line(start = [-10.0674 mm, -37.5720 mm], end = [-2.4822 mm, -18.8538 mm])
        i35 = line(start = [-2.4822 mm, -18.8538 mm], end = [-0.0000 mm, -38.8974 mm])
        i36 = line(start = [-0.0000 mm, -38.8974 mm], end = [2.4822 mm, -18.8538 mm])
        i37 = line(start = [2.4822 mm, -18.8538 mm], end = [10.0674 mm, -37.5720 mm])
        i38 = line(start = [10.0674 mm, -37.5720 mm], end = [7.2773 mm, -17.5690 mm])
        i39 = line(start = [7.2773 mm, -17.5690 mm], end = [19.4487 mm, -33.6862 mm])
        i40 = line(start = [19.4487 mm, -33.6862 mm], end = [11.5765 mm, -15.0868 mm])
        i41 = line(start = [11.5765 mm, -15.0868 mm], end = [27.5046 mm, -27.5046 mm])
        i42 = line(start = [27.5046 mm, -27.5046 mm], end = [15.0868 mm, -11.5765 mm])
        i43 = line(start = [15.0868 mm, -11.5765 mm], end = [33.6862 mm, -19.4487 mm])
        i44 = line(start = [33.6862 mm, -19.4487 mm], end = [17.5690 mm, -7.2773 mm])
        i45 = line(start = [17.5690 mm, -7.2773 mm], end = [37.5720 mm, -10.0674 mm])
        i46 = line(start = [37.5720 mm, -10.0674 mm], end = [18.8538 mm, -2.4822 mm])
        i47 = line(start = [18.8538 mm, -2.4822 mm], end = [38.8974 mm, 0.0000 mm])
    }
    feature media = extrude(profile = sketch.media_s, distance = input.height)

    // The cartridge's core: the oil inside the media, with the outlet port below it.
    sketch core_s on origin.xy {
        i0 = line(start = [38.8974 mm, 0.0000 mm], end = [18.8538 mm, 2.4822 mm])
        i1 = line(start = [18.8538 mm, 2.4822 mm], end = [37.5720 mm, 10.0674 mm])
        i2 = line(start = [37.5720 mm, 10.0674 mm], end = [17.5690 mm, 7.2773 mm])
        i3 = line(start = [17.5690 mm, 7.2773 mm], end = [33.6862 mm, 19.4487 mm])
        i4 = line(start = [33.6862 mm, 19.4487 mm], end = [15.0868 mm, 11.5765 mm])
        i5 = line(start = [15.0868 mm, 11.5765 mm], end = [27.5046 mm, 27.5046 mm])
        i6 = line(start = [27.5046 mm, 27.5046 mm], end = [11.5765 mm, 15.0868 mm])
        i7 = line(start = [11.5765 mm, 15.0868 mm], end = [19.4487 mm, 33.6862 mm])
        i8 = line(start = [19.4487 mm, 33.6862 mm], end = [7.2773 mm, 17.5690 mm])
        i9 = line(start = [7.2773 mm, 17.5690 mm], end = [10.0674 mm, 37.5720 mm])
        i10 = line(start = [10.0674 mm, 37.5720 mm], end = [2.4822 mm, 18.8538 mm])
        i11 = line(start = [2.4822 mm, 18.8538 mm], end = [0.0000 mm, 38.8974 mm])
        i12 = line(start = [0.0000 mm, 38.8974 mm], end = [-2.4822 mm, 18.8538 mm])
        i13 = line(start = [-2.4822 mm, 18.8538 mm], end = [-10.0674 mm, 37.5720 mm])
        i14 = line(start = [-10.0674 mm, 37.5720 mm], end = [-7.2773 mm, 17.5690 mm])
        i15 = line(start = [-7.2773 mm, 17.5690 mm], end = [-19.4487 mm, 33.6862 mm])
        i16 = line(start = [-19.4487 mm, 33.6862 mm], end = [-11.5765 mm, 15.0868 mm])
        i17 = line(start = [-11.5765 mm, 15.0868 mm], end = [-27.5046 mm, 27.5046 mm])
        i18 = line(start = [-27.5046 mm, 27.5046 mm], end = [-15.0868 mm, 11.5765 mm])
        i19 = line(start = [-15.0868 mm, 11.5765 mm], end = [-33.6862 mm, 19.4487 mm])
        i20 = line(start = [-33.6862 mm, 19.4487 mm], end = [-17.5690 mm, 7.2773 mm])
        i21 = line(start = [-17.5690 mm, 7.2773 mm], end = [-37.5720 mm, 10.0674 mm])
        i22 = line(start = [-37.5720 mm, 10.0674 mm], end = [-18.8538 mm, 2.4822 mm])
        i23 = line(start = [-18.8538 mm, 2.4822 mm], end = [-38.8974 mm, 0.0000 mm])
        i24 = line(start = [-38.8974 mm, 0.0000 mm], end = [-18.8538 mm, -2.4822 mm])
        i25 = line(start = [-18.8538 mm, -2.4822 mm], end = [-37.5720 mm, -10.0674 mm])
        i26 = line(start = [-37.5720 mm, -10.0674 mm], end = [-17.5690 mm, -7.2773 mm])
        i27 = line(start = [-17.5690 mm, -7.2773 mm], end = [-33.6862 mm, -19.4487 mm])
        i28 = line(start = [-33.6862 mm, -19.4487 mm], end = [-15.0868 mm, -11.5765 mm])
        i29 = line(start = [-15.0868 mm, -11.5765 mm], end = [-27.5046 mm, -27.5046 mm])
        i30 = line(start = [-27.5046 mm, -27.5046 mm], end = [-11.5765 mm, -15.0868 mm])
        i31 = line(start = [-11.5765 mm, -15.0868 mm], end = [-19.4487 mm, -33.6862 mm])
        i32 = line(start = [-19.4487 mm, -33.6862 mm], end = [-7.2773 mm, -17.5690 mm])
        i33 = line(start = [-7.2773 mm, -17.5690 mm], end = [-10.0674 mm, -37.5720 mm])
        i34 = line(start = [-10.0674 mm, -37.5720 mm], end = [-2.4822 mm, -18.8538 mm])
        i35 = line(start = [-2.4822 mm, -18.8538 mm], end = [-0.0000 mm, -38.8974 mm])
        i36 = line(start = [-0.0000 mm, -38.8974 mm], end = [2.4822 mm, -18.8538 mm])
        i37 = line(start = [2.4822 mm, -18.8538 mm], end = [10.0674 mm, -37.5720 mm])
        i38 = line(start = [10.0674 mm, -37.5720 mm], end = [7.2773 mm, -17.5690 mm])
        i39 = line(start = [7.2773 mm, -17.5690 mm], end = [19.4487 mm, -33.6862 mm])
        i40 = line(start = [19.4487 mm, -33.6862 mm], end = [11.5765 mm, -15.0868 mm])
        i41 = line(start = [11.5765 mm, -15.0868 mm], end = [27.5046 mm, -27.5046 mm])
        i42 = line(start = [27.5046 mm, -27.5046 mm], end = [15.0868 mm, -11.5765 mm])
        i43 = line(start = [15.0868 mm, -11.5765 mm], end = [33.6862 mm, -19.4487 mm])
        i44 = line(start = [33.6862 mm, -19.4487 mm], end = [17.5690 mm, -7.2773 mm])
        i45 = line(start = [17.5690 mm, -7.2773 mm], end = [37.5720 mm, -10.0674 mm])
        i46 = line(start = [37.5720 mm, -10.0674 mm], end = [18.8538 mm, -2.4822 mm])
        i47 = line(start = [18.8538 mm, -2.4822 mm], end = [38.8974 mm, 0.0000 mm])
    }
    feature core = extrude(profile = sketch.core_s, distance = input.height)
    feature outlet = extrude(profile = sketch.outlet_s, distance = input.port_length + 5 mm, mode = add(targets = [feature.core.body]))

    // The oil outside the media: the bowl with its inlet, less the cartridge.
    feature oil = boolean.subtract(target = feature.bowl.body, tools = [feature.media.body, feature.core.body], keep_tools = true)

    region inlet_face : face = { select = [feature.inlet.face.end], expect = exactly_one, body = feature.bowl.body, label = "Inlet" }
    region outlet_face : face = { select = [feature.outlet.face.start], expect = exactly_one, body = feature.core.body, label = "Outlet" }
    region wall : face = {
        select = [
            feature.bowl.face.side(bowl_s.wall),
            feature.bowl.face.start,
            feature.bowl.face.end,
            feature.core.face.start,
            feature.core.face.end,
            feature.inlet.face.side(inlet_s.pipe),
            feature.outlet.face.side(outlet_s.pipe),
            feature.media.face.start,
            feature.media.face.end
        ],
        expect = at_least_one,
        label = "Wall"
    }

    output oil = { body = feature.bowl.body, label = "Fluid", color = "#D08A1E" }
    output core_oil = { body = feature.core.body, label = "Fluid", color = "#D08A1E" }
    output media = { body = feature.media.body, label = "Media", material = "glass_fibre_media", color = "#E8E2CF" }
}
