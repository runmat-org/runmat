runmat 0.7
std 1

part features {
    feature bolt = hole(
        face = feature.body.face.end,
        at = { b = point(40 mm, 25 mm, input.thickness) },
        through_all,
        spec = { standard = iso, size = M6 },
        series = { end = { hole = tapped, modelled = true } }
    )
    feature row = pattern(
        features = [h],
        layout = linear(direction = origin.x, spacing = 15 mm, count = 4),
        skip = [{ instance = linear, step = 2 }]
    )
    feature lf = loft(profiles = [sketch.s_l0, sketch.s_l1, sketch.s_l2])
    sketch s1 on origin.xy {
        l1 = line(start = l4.end, end = [input.width, 0 mm])
        l2 = line(start = l1.end, end = [input.width, input.depth])
        l3 = line(start = l2.end, end = [0 mm, input.depth])
        l4 = line(start = l3.end, end = [0 mm, 0 mm])
        constrain fix(l1.start)
        constrain horizontal(l1)
        constrain vertical(l2)
        constrain horizontal(l3)
        constrain vertical(l4)
        constrain length(l1) = input.width
    }
    feature boss = extrude(profile = sketch.s2, up_to_next, mode = add)
