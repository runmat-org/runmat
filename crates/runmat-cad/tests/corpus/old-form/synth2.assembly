runmat 0.7
std 1

assembly section {
    input frame_pitch : length = 500 mm

    occurrence frame = {
        source = {
            definition = { kind = assembly, file = "fuselage/frame.assembly" },
            context = { context = live }
        },
        placement = {
            placement = offset,
            offset = { translation = [10 mm, 0 mm, 0 mm], rotation = { rotation = identity } }
        }
    }
    occurrence skin = {
        source = {
            definition = { kind = part, file = "fuselage/skin.part" },
            context = { context = live }
        }
    }
    occurrence stringer = {
        source = {
            definition = { kind = part, file = "library/stringer.part" },
            context = { context = live }
        }
    }

    pattern frames = {
        seeds = [frame],
        layout = { layout = linear, direction = [1, 0, 0], spacing = input.frame_pitch, count = 6 }
    }
    pattern stringers = {
        seeds = [stringer],
        layout = {
            layout = circular,
            axis_point = [0 mm, 0 mm, 0 mm],
            axis = [1, 0, 0],
            count = 8,
            angle = 360 deg
        }
    }

    fasteners lap0 = {
        layout = {
            layout = along,
            occurrence = [{ name = skin }],
            path = laps,
            chains = [lap0],
            spacing = { spacing = pitch, pitch = 21.6 mm },
            edge_distance = 2 * 4.8 mm,
            rows = [{ key = r0, offset = 0 mm }, { key = r1, offset = 25 mm }],
            stations = { basis = arc_length }
        },
        fastener = {
            family = { kind = part, file = "library/fasteners/hi-lok.part" },
            diameter = 4.8 mm,
            grip = { grip = auto }
        },
        stack = [[{ name = skin }], [{ name = stringer }]],
        exceptions = [
            {
                at = { at = station, station = 74.4 mm, chain = lap0, row = r0 },
                action = { action = oversize, delta = 0.4 mm }
            }
        ]
    }

    part_number = "SE-120"
}
