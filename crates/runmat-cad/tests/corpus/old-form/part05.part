runmat 0.7
std 1

part bracket {
    input width : length = 80 mm
    input depth : length = 50 mm
    input thickness : length = 10 mm

    feature s1 = sketch {
        plane = { on = datum, datum = { datum = origin_plane, plane = xy } },
        entities = [
            {
                id = l1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = 0 mm },
                    end = { point = coords, x = input.width, y = 0 mm }
                },
                construction = false
            },
            {
                id = l2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = 0 mm },
                    end = { point = coords, x = input.width, y = input.depth }
                },
                construction = false
            },
            {
                id = l3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = input.depth },
                    end = { point = coords, x = 0 mm, y = input.depth }
                },
                construction = false
            },
            {
                id = l4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = input.depth },
                    end = { point = coords, x = 0 mm, y = 0 mm }
                },
                construction = false
            }
        ]
    }
    feature body = extrude {
        profile = { sketch = s1, loops = [] },
        extent = { extent = blind, distance = input.thickness }
    }
    feature s_logo = sketch {
        plane = {
            on = face,
            face = {
                ref = name,
                kind = face,
                name = { form = generated, feature = body, role = end_cap, tag = { tag = "none" } }
            }
        },
        entities = [
            {
                id = g1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 10 mm, y = 10 mm },
                    end = { point = coords, x = 20 mm, y = 10 mm }
                },
                construction = false
            },
            {
                id = g2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 20 mm, y = 10 mm },
                    end = { point = coords, x = 20 mm, y = 15 mm }
                },
                construction = false
            },
            {
                id = g3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 20 mm, y = 15 mm },
                    end = { point = coords, x = 10 mm, y = 15 mm }
                },
                construction = false
            },
            {
                id = g4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 10 mm, y = 15 mm },
                    end = { point = coords, x = 10 mm, y = 10 mm }
                },
                construction = false
            }
        ]
    }
    feature logo = emboss {
        profile = { sketch = s_logo, loops = [] },
        face = {
            ref = name,
            kind = face,
            name = { form = generated, feature = body, role = end_cap, tag = { tag = "none" } }
        },
        height = 1 mm
    }
    feature coil = curve {
        curve = helix,
        axis = { along = datum, datum = { datum = origin_axis, axis = z } },
        start = { point = coords, x = 10 mm, y = 0 mm, z = 0 mm },
        pitch = 2 mm,
        turns = 3
    }
    feature tilted = plane {
        plane = three_point,
        a = { point = coords, x = 0 mm, y = 0 mm, z = 0 mm },
        b = { point = coords, x = 10 mm, y = 0 mm, z = 0 mm },
        c = { point = coords, x = 0 mm, y = 10 mm, z = 10 mm }
    }
    feature mc = mate_connector {
        placement = {
            on = frame,
            frame = {
                frame = on_face,
                face = {
                    ref = name,
                    kind = face,
                    name = { form = generated, feature = body, role = end_cap, tag = { tag = "none" } }
                }
            }
        },
        offset = [0 mm, 0 mm, 2 mm]
    }

    output bracket = {
        body = {
            ref = name,
            kind = body,
            name = { form = generated, feature = body, role = body, tag = { tag = "none" } }
        },
        part_number = "BR-100",
        material = "material.aluminum"
    }
}
