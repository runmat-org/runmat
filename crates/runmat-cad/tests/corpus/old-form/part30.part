runmat 0.7
std 1

part bracket {
    input width : length = 80 mm
    input depth : length = 50 mm
    input thickness : length = 10 mm

    feature s1 = sketch {
        plane = { on = datum, datum = { datum = origin_plane, plane = xy } },
        entities = [
            {
                id = l1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = 0 mm },
                    end = { point = coords, x = input.width, y = 0 mm }
                },
                construction = false
            },
            {
                id = l2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = 0 mm },
                    end = { point = coords, x = input.width, y = input.depth }
                },
                construction = false
            },
            {
                id = l3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = input.depth },
                    end = { point = coords, x = 0 mm, y = input.depth }
                },
                construction = false
            },
            {
                id = l4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = input.depth },
                    end = { point = coords, x = 0 mm, y = 0 mm }
                },
                construction = false
            }
        ]
    }
    feature body = extrude {
        profile = { sketch = s1, loops = [] },
        extent = { extent = blind, distance = input.thickness }
    }
    feature s2 = sketch {
        plane = { on = datum, datum = { datum = origin_plane, plane = xy } },
        entities = [
            {
                id = n1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 20 mm, y = 20 mm },
                    end = { point = coords, x = 40 mm, y = 20 mm }
                },
                construction = false
            },
            {
                id = n2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 40 mm, y = 20 mm },
                    end = { point = coords, x = 40 mm, y = 30 mm }
                },
                construction = false
            },
            {
                id = n3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 40 mm, y = 30 mm },
                    end = { point = coords, x = 20 mm, y = 30 mm }
                },
                construction = false
            },
            {
                id = n4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 20 mm, y = 30 mm },
                    end = { point = coords, x = 20 mm, y = 20 mm }
                },
                construction = false
            }
        ]
    }
    feature pocket_tool = extrude { profile = { sketch = s2, loops = [] }, extent = { extent = blind, distance = 30 mm } }
    feature pocket = boolean {
        kind = subtract,
        target = {
            ref = name,
            kind = body,
            name = { form = generated, feature = body, role = body, tag = { tag = "none" } }
        },
        tools = [
            {
                ref = name,
                kind = body,
                name = { form = generated, feature = pocket_tool, role = body, tag = { tag = "none" } }
            }
        ]
    }

    output bracket = {
        body = {
            ref = name,
            kind = body,
            name = { form = generated, feature = body, role = body, tag = { tag = "none" } }
        },
        part_number = "BR-100",
        material = "material.aluminum"
    }

    region top : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = { form = generated, feature = body, role = end_cap, tag = { tag = "none" } }
            }
        ],
        expect = exactly_one
    }
    region front : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = {
                    form = generated,
                    feature = body,
                    role = side,
                    tag = { tag = curve, sketch = s1, entity = l1 }
                }
            }
        ],
        expect = exactly_one
    }
    region right : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = {
                    form = generated,
                    feature = body,
                    role = side,
                    tag = { tag = curve, sketch = s1, entity = l2 }
                }
            }
        ],
        expect = exactly_one
    }
    region front_top : edge = {
        select = [
            {
                ref = edges_between,
                a = {
                    ref = name,
                    kind = face,
                    name = {
                        form = generated,
                        feature = body,
                        role = side,
                        tag = { tag = curve, sketch = s1, entity = l1 }
                    }
                },
                b = {
                    ref = name,
                    kind = face,
                    name = { form = generated, feature = body, role = end_cap, tag = { tag = "none" } }
                }
            }
        ],
        expect = at_least_one
    }
    region tool : body = {
        select = [
            {
                ref = name,
                kind = body,
                name = { form = generated, feature = pocket_tool, role = body, tag = { tag = "none" } }
            }
        ],
        expect = exactly_one
    }
    region wall : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = {
                    form = generated,
                    feature = pocket_tool,
                    role = side,
                    tag = { tag = curve, sketch = s2, entity = n1 }
                }
            }
        ],
        expect = exactly_one
    }
}
