runmat 0.7
std 1

part bracket {
    input width : length = 80 mm
    input depth : length = 50 mm
    input thickness : length = 10 mm

    feature s1 = sketch {
        plane = { on = datum, datum = { datum = origin_plane, plane = xy } },
        entities = [
            {
                id = l1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = 0 mm },
                    end = { point = coords, x = input.width, y = 0 mm }
                },
                construction = false
            },
            {
                id = l2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = 0 mm },
                    end = { point = coords, x = input.width, y = input.depth }
                },
                construction = false
            },
            {
                id = l3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = input.depth },
                    end = { point = coords, x = 0 mm, y = input.depth }
                },
                construction = false
            },
            {
                id = l4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = input.depth },
                    end = { point = coords, x = 0 mm, y = 0 mm }
                },
                construction = false
            }
        ]
    }
    feature body = extrude {
        profile = { sketch = s1, loops = [] },
        extent = { extent = blind, distance = input.thickness }
    }
    feature level = plane {
        plane = offset,
        base = { on = datum, datum = { datum = origin_plane, plane = xy } },
        distance = 4 mm
    }
    feature s_sheet = sketch {
        plane = { on = datum, datum = { datum = feature, feature = level } },
        entities = [
            {
                id = a,
                geometry = {
                    entity = line,
                    start = { point = coords, x = -10 mm, y = -10 mm },
                    end = { point = coords, x = 90 mm, y = -10 mm }
                },
                construction = false
            },
            {
                id = b,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 90 mm, y = -10 mm },
                    end = { point = coords, x = 90 mm, y = 60 mm }
                },
                construction = false
            },
            {
                id = c,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 90 mm, y = 60 mm },
                    end = { point = coords, x = -10 mm, y = 60 mm }
                },
                construction = false
            },
            {
                id = e,
                geometry = {
                    entity = line,
                    start = { point = coords, x = -10 mm, y = 60 mm },
                    end = { point = coords, x = -10 mm, y = -10 mm }
                },
                construction = false
            }
        ]
    }
    feature sheet = surface { kind = planar, profile = { sketch = s_sheet, loops = [] } }
    feature trim = surface {
        kind = cut_with_surface,
        body = {
            ref = name,
            kind = body,
            name = { form = generated, feature = body, role = body, tag = { tag = "none" } }
        },
        surface = {
            ref = name,
            kind = body,
            name = { form = generated, feature = sheet, role = body, tag = { tag = "none" } }
        },
        keep = negative
    }

    output bracket = {
        body = {
            ref = name,
            kind = body,
            name = { form = generated, feature = body, role = body, tag = { tag = "none" } }
        },
        part_number = "BR-100",
        material = "material.aluminum"
    }
}
