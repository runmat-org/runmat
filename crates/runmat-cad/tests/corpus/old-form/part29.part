runmat 0.7
std 1

part bracket {
    input width : length = 80 mm
    input depth : length = 50 mm
    input thickness : length = 10 mm

    feature s1 = sketch {
        plane = { on = datum, datum = { datum = origin_plane, plane = xy } },
        entities = [
            {
                id = l1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = 0 mm },
                    end = { point = coords, x = input.width, y = 0 mm }
                },
                construction = false
            },
            {
                id = l2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = 0 mm },
                    end = { point = coords, x = input.width, y = input.depth }
                },
                construction = false
            },
            {
                id = l3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = input.depth },
                    end = { point = coords, x = 0 mm, y = input.depth }
                },
                construction = false
            },
            {
                id = l4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = input.depth },
                    end = { point = coords, x = 0 mm, y = 0 mm }
                },
                construction = false
            }
        ]
    }
    feature body = extrude {
        profile = { sketch = s1, loops = [] },
        extent = { extent = blind, distance = input.thickness }
    }
    feature s_pocket = sketch {
        plane = {
            on = face,
            face = {
                ref = name,
                kind = face,
                name = { form = generated, feature = body, role = end_cap, tag = { tag = "none" } }
            }
        },
        entities = [
            {
                id = p1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 20 mm, y = 10 mm },
                    end = { point = coords, x = 40 mm, y = 10 mm }
                },
                construction = false
            },
            {
                id = p2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 40 mm, y = 10 mm },
                    end = { point = coords, x = 40 mm, y = 30 mm }
                },
                construction = false
            },
            {
                id = p3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 40 mm, y = 30 mm },
                    end = { point = coords, x = 20 mm, y = 30 mm }
                },
                construction = false
            },
            {
                id = p4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 20 mm, y = 30 mm },
                    end = { point = coords, x = 20 mm, y = 10 mm }
                },
                construction = false
            }
        ]
    }
    feature pocket = extrude {
        profile = { sketch = s_pocket, loops = [] },
        extent = { extent = blind, distance = 4 mm },
        reverse = true,
        mode = { mode = cut, targets = [] }
    }
    feature heal = direct {
        direct = delete_faces,
        faces = [
            {
                ref = name,
                kind = face,
                name = {
                    form = generated,
                    feature = pocket,
                    role = side,
                    tag = { tag = curve, sketch = s_pocket, entity = p1 }
                }
            },
            {
                ref = name,
                kind = face,
                name = {
                    form = generated,
                    feature = pocket,
                    role = side,
                    tag = { tag = curve, sketch = s_pocket, entity = p2 }
                }
            },
            {
                ref = name,
                kind = face,
                name = {
                    form = generated,
                    feature = pocket,
                    role = side,
                    tag = { tag = curve, sketch = s_pocket, entity = p3 }
                }
            },
            {
                ref = name,
                kind = face,
                name = {
                    form = generated,
                    feature = pocket,
                    role = side,
                    tag = { tag = curve, sketch = s_pocket, entity = p4 }
                }
            },
            {
                ref = name,
                kind = face,
                name = { form = generated, feature = pocket, role = end_cap, tag = { tag = "none" } }
            }
        ]
    }

    output bracket = {
        body = {
            ref = name,
            kind = body,
            name = { form = generated, feature = body, role = body, tag = { tag = "none" } }
        },
        part_number = "BR-100",
        material = "material.aluminum"
    }
}
