runmat 0.7
std 1

part bracket {
    input width : length = 80 mm
    input depth : length = 50 mm
    input thickness : length = 10 mm

    feature s1 = sketch {
        plane = { on = datum, datum = { datum = origin_plane, plane = xy } },
        entities = [
            {
                id = l1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = 0 mm },
                    end = { point = coords, x = input.width, y = 0 mm }
                },
                construction = false
            },
            {
                id = l2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = 0 mm },
                    end = { point = coords, x = input.width, y = input.depth }
                },
                construction = false
            },
            {
                id = l3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = input.depth },
                    end = { point = coords, x = 0 mm, y = input.depth }
                },
                construction = false
            },
            {
                id = l4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = input.depth },
                    end = { point = coords, x = 0 mm, y = 0 mm }
                },
                construction = false
            }
        ]
    }
    feature body = extrude {
        profile = { sketch = s1, loops = [] },
        extent = { extent = blind, distance = input.thickness }
    }
    feature tap = hole {
        face = {
            ref = name,
            kind = face,
            name = { form = generated, feature = body, role = end_cap, tag = { tag = "none" } }
        },
        positions = [{ key = m6, at = { point = coords, x = 40 mm, y = 25 mm, z = 10 mm } }],
        diameter = 5 mm,
        end = { end = through_all }
    }
    feature m6_thread = thread {
        face = {
            ref = name,
            kind = face,
            name = { form = generated, feature = tap, role = hole_wall, tag = { tag = key, key = m6 } }
        },
        spec = { designation = M6x1, pitch = 1 mm, depth = 0.54 mm, left_hand = false, class = "6H" }
    }
    feature boss1 = library { def = "feature_def.boss", args = { h = 8 mm }, mode = { mode = add, targets = [] } }

    output bracket = {
        body = {
            ref = name,
            kind = body,
            name = { form = generated, feature = body, role = body, tag = { tag = "none" } }
        },
        part_number = "BR-100",
        material = "material.aluminum"
    }

    feature_def boss = {
        params = [{ name = h, kind = length, default = 5 mm }],
        features = [
            {
                id = s,
                kind = {
                    feature = sketch,
                    plane = { on = datum, datum = { datum = origin_plane, plane = xy } },
                    entities = [
                        {
                            id = q1,
                            geometry = {
                                entity = line,
                                start = { point = coords, x = 60 mm, y = 10 mm },
                                end = { point = coords, x = 70 mm, y = 10 mm }
                            },
                            construction = false
                        },
                        {
                            id = q2,
                            geometry = {
                                entity = line,
                                start = { point = coords, x = 70 mm, y = 10 mm },
                                end = { point = coords, x = 70 mm, y = 20 mm }
                            },
                            construction = false
                        },
                        {
                            id = q3,
                            geometry = {
                                entity = line,
                                start = { point = coords, x = 70 mm, y = 20 mm },
                                end = { point = coords, x = 60 mm, y = 20 mm }
                            },
                            construction = false
                        },
                        {
                            id = q4,
                            geometry = {
                                entity = line,
                                start = { point = coords, x = 60 mm, y = 20 mm },
                                end = { point = coords, x = 60 mm, y = 10 mm }
                            },
                            construction = false
                        }
                    ],
                    constraints = [],
                    solved = { points = [], scalars = [] }
                },
                suppressed = false
            },
            {
                id = e,
                kind = {
                    feature = extrude,
                    profile = { sketch = s, loops = [] },
                    extent = { extent = blind, distance = input.h },
                    reverse = true,
                    mode = { mode = add, targets = [] }
                },
                suppressed = false
            }
        ]
    }
}
