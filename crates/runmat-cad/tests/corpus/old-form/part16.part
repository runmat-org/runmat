runmat 0.7
std 1

part bracket {
    input width : length = 80 mm
    input depth : length = 50 mm
    input thickness : length = 10 mm
    input tz : length = 10 mm

    feature s1 = sketch {
        plane = { on = datum, datum = { datum = origin_plane, plane = xy } },
        entities = [
            {
                id = l1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = 0 mm },
                    end = { point = coords, x = input.width, y = 0 mm }
                },
                construction = false
            },
            {
                id = l2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = 0 mm },
                    end = { point = coords, x = input.width, y = input.depth }
                },
                construction = false
            },
            {
                id = l3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = input.depth },
                    end = { point = coords, x = 0 mm, y = input.depth }
                },
                construction = false
            },
            {
                id = l4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = input.depth },
                    end = { point = coords, x = 0 mm, y = 0 mm }
                },
                construction = false
            }
        ]
    }
    feature body = extrude {
        profile = { sketch = s1, loops = [] },
        extent = { extent = blind, distance = input.thickness }
    }
    feature s_t = sketch {
        plane = { on = datum, datum = { datum = origin_plane, plane = xy } },
        entities = [
            {
                id = l1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 70 mm, y = 10 mm },
                    end = { point = coords, x = 90 mm, y = 10 mm }
                },
                construction = false
            },
            {
                id = l2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 90 mm, y = 10 mm },
                    end = { point = coords, x = 90 mm, y = 20 mm }
                },
                construction = false
            },
            {
                id = l3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 90 mm, y = 20 mm },
                    end = { point = coords, x = 70 mm, y = 20 mm }
                },
                construction = false
            },
            {
                id = l4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 70 mm, y = 20 mm },
                    end = { point = coords, x = 70 mm, y = 10 mm }
                },
                construction = false
            }
        ]
    }
    feature tool = extrude { profile = { sketch = s_t, loops = [] }, extent = { extent = blind, distance = input.tz } }
    feature uni = boolean {
        kind = union,
        target = {
            ref = name,
            kind = body,
            name = { form = generated, feature = body, role = body, tag = { tag = "none" } }
        },
        tools = [
            {
                ref = name,
                kind = body,
                name = { form = generated, feature = tool, role = body, tag = { tag = "none" } }
            }
        ],
        suppressed = true
    }

    output bracket = {
        body = {
            ref = name,
            kind = body,
            name = { form = generated, feature = body, role = body, tag = { tag = "none" } }
        },
        part_number = "BR-100",
        material = "material.aluminum"
    }

    region tool_right : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = {
                    form = generated,
                    feature = tool,
                    role = side,
                    tag = { tag = curve, sketch = s_t, entity = l2 }
                }
            }
        ],
        expect = exactly_one
    }
    region tool_top : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = { form = generated, feature = tool, role = end_cap, tag = { tag = "none" } }
            }
        ],
        expect = exactly_one
    }
    region blk_top : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = { form = generated, feature = body, role = end_cap, tag = { tag = "none" } }
            }
        ],
        expect = exactly_one
    }
    region blk_body : body = {
        select = [
            {
                ref = name,
                kind = body,
                name = { form = generated, feature = body, role = body, tag = { tag = "none" } }
            }
        ],
        expect = exactly_one
    }
}
