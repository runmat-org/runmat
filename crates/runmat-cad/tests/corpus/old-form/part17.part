runmat 0.7
std 1

part bracket {
    input width : length = 80 mm
    input depth : length = 50 mm
    input thickness : length = 10 mm
    input md : length = 3 mm

    feature s1 = sketch {
        plane = { on = datum, datum = { datum = origin_plane, plane = xy } },
        entities = [
            {
                id = l1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = 0 mm },
                    end = { point = coords, x = input.width, y = 0 mm }
                },
                construction = false
            },
            {
                id = l2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = 0 mm },
                    end = { point = coords, x = input.width, y = input.depth }
                },
                construction = false
            },
            {
                id = l3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = input.depth },
                    end = { point = coords, x = 0 mm, y = input.depth }
                },
                construction = false
            },
            {
                id = l4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = input.depth },
                    end = { point = coords, x = 0 mm, y = 0 mm }
                },
                construction = false
            }
        ]
    }
    feature body = extrude {
        profile = { sketch = s1, loops = [] },
        extent = { extent = blind, distance = input.thickness }
    }
    feature top_plane = plane {
        plane = offset,
        base = { on = datum, datum = { datum = origin_plane, plane = xy } },
        distance = input.thickness
    }
    feature s_pk2 = sketch {
        plane = { on = datum, datum = { datum = feature, feature = top_plane } },
        entities = [
            {
                id = l1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 25 mm, y = 5 mm },
                    end = { point = coords, x = 35 mm, y = 5 mm }
                },
                construction = false
            },
            {
                id = l2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 35 mm, y = 5 mm },
                    end = { point = coords, x = 35 mm, y = 15 mm }
                },
                construction = false
            },
            {
                id = l3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 35 mm, y = 15 mm },
                    end = { point = coords, x = 25 mm, y = 15 mm }
                },
                construction = false
            },
            {
                id = l4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 25 mm, y = 15 mm },
                    end = { point = coords, x = 25 mm, y = 5 mm }
                },
                construction = false
            }
        ]
    }
    feature pk2 = extrude {
        profile = { sketch = s_pk2, loops = [] },
        extent = { extent = blind, distance = input.md },
        reverse = true,
        mode = { mode = cut, targets = [] }
    }
    feature mp = plane {
        plane = angle,
        base = { on = datum, datum = { datum = origin_plane, plane = yz } },
        axis = { along = datum, datum = { datum = origin_axis, axis = z } },
        angle = -45 deg
    }
    feature mir = mirror {
        seeds = { seeds = features, features = [pk2] },
        plane = { on = datum, datum = { datum = feature, feature = mp } },
        suppressed = true
    }

    output bracket = {
        body = {
            ref = name,
            kind = body,
            name = { form = generated, feature = body, role = body, tag = { tag = "none" } }
        },
        part_number = "BR-100",
        material = "material.aluminum"
    }

    region mir_floor : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = {
                    form = copy,
                    base = bf3eb921d0db60d7cabf7d22fd055413,
                    whole = bf3eb921d0db60d7cabf7d22fd055413,
                    pattern = mir,
                    instance = { instance = mirror }
                }
            }
        ],
        expect = exactly_one
    }
    region mir_wall : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = {
                    form = copy,
                    base = "493373e2750901efc3fa5741797dfab1",
                    whole = "493373e2750901efc3fa5741797dfab1",
                    pattern = mir,
                    instance = { instance = mirror }
                }
            }
        ],
        expect = exactly_one
    }
    region seed_floor : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = { form = generated, feature = pk2, role = end_cap, tag = { tag = "none" } }
            }
        ],
        expect = exactly_one
    }
}
