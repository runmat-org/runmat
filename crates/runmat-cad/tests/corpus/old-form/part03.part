runmat 0.7
std 1

part skin {
    feature s = sketch {
        plane = { on = datum, datum = { datum = origin_plane, plane = xy } },
        entities = [
            {
                id = a,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = 0 mm },
                    end = { point = coords, x = 40 mm, y = 0 mm }
                },
                construction = false
            },
            {
                id = b,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 40 mm, y = 0 mm },
                    end = { point = coords, x = 40 mm, y = 20 mm }
                },
                construction = false
            },
            {
                id = c,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 40 mm, y = 20 mm },
                    end = { point = coords, x = 0 mm, y = 20 mm }
                },
                construction = false
            },
            {
                id = e,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = 20 mm },
                    end = { point = coords, x = 0 mm, y = 0 mm }
                },
                construction = false
            }
        ]
    }
    feature patch = surface { kind = planar, profile = { sketch = s, loops = [] } }
    feature grow = surface {
        kind = extend,
        edges = [
            {
                ref = name,
                kind = edge,
                name = {
                    form = generated,
                    feature = patch,
                    role = boundary,
                    tag = { tag = curve, sketch = s, entity = b }
                }
            }
        ],
        distance = 10 mm
    }
    feature solid = surface {
        kind = thicken,
        bodies = [
            {
                ref = name,
                kind = body,
                name = { form = generated, feature = patch, role = body, tag = { tag = "none" } }
            }
        ],
        thickness = 3 mm
    }
}
