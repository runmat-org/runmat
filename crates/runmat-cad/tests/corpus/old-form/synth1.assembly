runmat 0.7
std 1

assembly frame {
    occurrence web = {
        source = {
            definition = { kind = part, file = "library/frame-std.part" },
            context = { context = live }
        },
        configuration = {
            select = switch,
            cases = [
                {
                    when = { when = range, axis = msn, min = 41 },
                    select = { select = named, name = heavy }
                }
            ],
            otherwise = { select = named, name = std }
        }
    }
    occurrence clip = {
        source = {
            definition = { kind = part, file = "library/clip.part" },
            context = { context = live }
        },
        placement = {
            placement = offset,
            offset = { translation = [20 mm, -1500 mm, 1900 mm], rotation = { rotation = identity } }
        }
    }

    pattern clips = {
        seeds = [clip],
        layout = { layout = linear, direction = [0, 1, 0], spacing = 750 mm, count = 4 }
    }

    part_number = "FA-110"
}
