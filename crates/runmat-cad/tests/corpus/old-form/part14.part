runmat 0.7
std 1

part bracket {
    input width : length = 80 mm
    input depth : length = 50 mm
    input thickness : length = 10 mm
    input gi : length = 8 mm
    input go : length = 14 mm
    input gdep : length = 4 mm

    feature s1 = sketch {
        plane = { on = datum, datum = { datum = origin_plane, plane = xy } },
        entities = [
            {
                id = l1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = 0 mm },
                    end = { point = coords, x = input.width, y = 0 mm }
                },
                construction = false
            },
            {
                id = l2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = 0 mm },
                    end = { point = coords, x = input.width, y = input.depth }
                },
                construction = false
            },
            {
                id = l3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.width, y = input.depth },
                    end = { point = coords, x = 0 mm, y = input.depth }
                },
                construction = false
            },
            {
                id = l4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = input.depth },
                    end = { point = coords, x = 0 mm, y = 0 mm }
                },
                construction = false
            }
        ]
    }
    feature body = extrude {
        profile = { sketch = s1, loops = [] },
        extent = { extent = blind, distance = input.thickness }
    }
    feature gplane = plane {
        plane = offset,
        base = { on = datum, datum = { datum = origin_plane, plane = zx } },
        distance = 25 mm
    }
    feature gaxis = axis {
        axis = through,
        a = { point = coords, x = 40 mm, y = 25 mm, z = 0 mm },
        b = { point = coords, x = 40 mm, y = 25 mm, z = 10 mm }
    }
    feature s_gr = sketch {
        plane = { on = datum, datum = { datum = feature, feature = gplane } },
        entities = [
            {
                id = l1,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.thickness - input.gdep, y = 40 mm + input.gi },
                    end = { point = coords, x = input.thickness + 2 mm, y = 40 mm + input.gi }
                },
                construction = false
            },
            {
                id = l2,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.thickness + 2 mm, y = 40 mm + input.gi },
                    end = { point = coords, x = input.thickness + 2 mm, y = 40 mm + input.go }
                },
                construction = false
            },
            {
                id = l3,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.thickness + 2 mm, y = 40 mm + input.go },
                    end = { point = coords, x = input.thickness - input.gdep, y = 40 mm + input.go }
                },
                construction = false
            },
            {
                id = l4,
                geometry = {
                    entity = line,
                    start = { point = coords, x = input.thickness - input.gdep, y = 40 mm + input.go },
                    end = { point = coords, x = input.thickness - input.gdep, y = 40 mm + input.gi }
                },
                construction = false
            }
        ]
    }
    feature groove = revolve {
        profile = { sketch = s_gr, loops = [] },
        axis = { along = datum, datum = { datum = feature, feature = gaxis } },
        angle = 360 deg,
        mode = { mode = cut, targets = [] },
        suppressed = true
    }

    output bracket = {
        body = {
            ref = name,
            kind = body,
            name = { form = generated, feature = body, role = body, tag = { tag = "none" } }
        },
        part_number = "BR-100",
        material = "material.aluminum"
    }

    region g_out : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = {
                    form = generated,
                    feature = groove,
                    role = side,
                    tag = { tag = curve, sketch = s_gr, entity = l3 }
                }
            }
        ],
        expect = exactly_one
    }
    region g_in : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = {
                    form = generated,
                    feature = groove,
                    role = side,
                    tag = { tag = curve, sketch = s_gr, entity = l1 }
                }
            }
        ],
        expect = exactly_one
    }
    region g_floor : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = {
                    form = generated,
                    feature = groove,
                    role = side,
                    tag = { tag = curve, sketch = s_gr, entity = l4 }
                }
            }
        ],
        expect = exactly_one
    }
    region blk_top_pieces : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = { form = generated, feature = body, role = end_cap, tag = { tag = "none" } }
            }
        ],
        expect = at_least_one
    }
    region blk_top_one : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = { form = generated, feature = body, role = end_cap, tag = { tag = "none" } }
            }
        ],
        expect = exactly_one
    }
}
