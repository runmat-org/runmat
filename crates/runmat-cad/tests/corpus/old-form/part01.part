runmat 0.7
std 1

part bracket_sm {
    feature s_chain = sketch {
        plane = { on = datum, datum = { datum = origin_plane, plane = zx } },
        entities = [
            {
                id = up,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = 30 mm },
                    end = { point = coords, x = 0 mm, y = 0 mm }
                },
                construction = false
            },
            {
                id = base,
                geometry = {
                    entity = line,
                    start = { point = coords, x = 0 mm, y = 0 mm },
                    end = { point = coords, x = 50 mm, y = 0 mm }
                },
                construction = false
            }
        ]
    }
    feature base = sheet_metal {
        sheet_metal = base_flange,
        profile = { sketch = s_chain, loops = [] },
        depth = 40 mm,
        rules = {
            thickness = 2 mm,
            bend_radius = 3 mm,
            rule = { rule = k_factor, k = 0.44 },
            relief = { relief = tear }
        }
    }
    feature jog = sheet_metal { sheet_metal = fold }
}
