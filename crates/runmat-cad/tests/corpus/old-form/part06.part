runmat 0.7
std 1

part housing {
    feature step = import { source = "supplier/housing.step", digest = d2 }

    output housing = {
        body = { ref = name, kind = body, name = { form = cad_file, import = step, name = housing } }
    }

    region lid : face = {
        select = [{ ref = name, kind = face, name = { form = cad_file, import = step, name = lid } }],
        expect = exactly_one
    }
    region right : face = {
        select = [
            {
                ref = name,
                kind = face,
                name = { form = cad_file, import = step, name = mount_right }
            }
        ],
        expect = exactly_one
    }
}
