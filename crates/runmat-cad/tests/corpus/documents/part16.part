runmat 0.7
std 1

part bracket {
    input width : length = 80 mm
    input depth : length = 50 mm
    input thickness : length = 10 mm
    input tz : length = 10 mm

    sketch s1 on origin.xy {
        l1 = line(start = [0 mm, 0 mm], end = [input.width, 0 mm])
        l2 = line(start = [input.width, 0 mm], end = [input.width, input.depth])
        l3 = line(start = [input.width, input.depth], end = [0 mm, input.depth])
        l4 = line(start = [0 mm, input.depth], end = [0 mm, 0 mm])
    }
    feature body = extrude(profile = sketch.s1, distance = input.thickness)
    sketch s_t on origin.xy {
        l1 = line(start = [70 mm, 10 mm], end = [90 mm, 10 mm])
        l2 = line(start = [90 mm, 10 mm], end = [90 mm, 20 mm])
        l3 = line(start = [90 mm, 20 mm], end = [70 mm, 20 mm])
        l4 = line(start = [70 mm, 20 mm], end = [70 mm, 10 mm])
    }
    feature tool = extrude(profile = sketch.s_t, distance = input.tz)
    feature uni = boolean.union(target = feature.body.body, tools = [feature.tool.body], suppressed)

    output bracket = { body = feature.body.body, part_number = "BR-100", material = "material.aluminum" }

    region tool_right : face = { select = [feature.tool.face.side(s_t.l2)], expect = exactly_one }
    region tool_top : face = { select = [feature.tool.face.end], expect = exactly_one }
    region blk_top : face = { select = [feature.body.face.end], expect = exactly_one }
    region blk_body : body = { select = [feature.body.body], expect = exactly_one }
}
