runmat 0.7
std 1

part bracket_sm {
    sketch s_chain on origin.zx {
        up = line(start = [0 mm, 30 mm], end = [0 mm, 0 mm])
        base = line(start = [0 mm, 0 mm], end = [50 mm, 0 mm])
    }
    feature base = sheet_metal.base_flange(
        profile = sketch.s_chain,
        depth = 40 mm,
        rules = { thickness = 2 mm, bend_radius = 3 mm, rule = k_factor(k = 0.44) }
    )
    feature flat = sheet_metal.flat_pattern(fixed_face = feature.base.face.sheet(base, ordinal = 0))
    feature lip = sheet_metal.edge_flange(
        edges = [
            edges_between(feature.base.face.sheet(base, ordinal = 0), feature.base.face.sheet_edge(base, ordinal = 1))
        ],
        length = 12 mm,
        angle = 90 deg,
        length_reference = tangent
    )
}
