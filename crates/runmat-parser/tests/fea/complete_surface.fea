import material aluminum from "./materials/aluminum.fea"
import model mounting from "./models/mounting.fea"
import function makeBracket from "./makeBracket.m"

geometry imported_bracket {
    file = "./geometry/bracket.step"
    units = mm

    cad_parameter wall_thickness : length {
        select name "WallThickness"
        expect exactly_one
        require readable
    }

    region body : solid {
        select name "Bracket"
        expect exactly_one
    }

    region fixed_base : face {
        select tag "fixed"
        expect one_or_more
    }
}

geometry generated_bracket {
    input width : length = 80 mm
    input height : length = 50 mm
    input thickness : length = 8 mm

    construct {
        feature stock = box(
            width = input.width,
            depth = input.thickness,
            height = input.height,
        )
        feature hole = cylinder(
            radius = 5 mm,
            height = input.thickness,
            axis = global([0, 1, 0]),
            origin = [15, 0, 15] mm,
        )
        result = subtract(feature.stock, feature.hole)
    }

    region body : solid {
        select result
        expect exactly_one
    }
}

geometry lightened_bracket from geometry.generated_bracket {
    input relief_radius : length = 8 mm

    derive {
        feature relief = cylinder(radius = input.relief_radius, height = 8 mm)
        result = subtract(source.result, feature.relief)
    }
}

geometry procedural_bracket {
    input width : length = 80 mm

    generated by function.makeBracket {
        arguments {
            width = input.width
        }
    }

    region body : solid {
        select output.region.body
        expect exactly_one
    }
}

mesh bracket_mesh on geometry.imported_bracket {
    tetrahedra {
        order = quadratic
        target_size = 5 mm
        maximum_deviation = 0.05 mm
    }
}

material steel {
    name = "Structural steel"
    mass_density = 7850 kg/m^3

    elastic {
        youngs_modulus = 200 GPa
        poisson_ratio = 0.30
    }
}

material cad_steel from geometry.imported_bracket.cad_material("mat-uuid") {
    use mass_density
    use elastic.youngs_modulus
    require operating_temperature = 20 degC
    on_conflict = reject
}

model bracket(region body : region<solid>, region pad : region<face>) {
    input body_material : material
    input service_load : force = 1 kN
    input imported_thickness : length =
        geometry.imported_bracket.parameter.wall_thickness

    include model.mounting
    assign input.body_material to input.body

    orientation laminate_axes {
        cartesian {
            origin = [0 m, 0 m, 0 m]
            x_axis = [1, 0, 0]
            y_axis = [0, 1, 0]
        }
    }

    section rail {
        rectangular_beam {
            width = 20 mm
            height = 40 mm
        }
    }

    layup skin {
        reference_orientation = orientation.laminate_axes
        stacking_direction = 1
        ply outer {
            material = input.body_material
            thickness = 0.2 mm
            angle = 0 deg
            integration_points = 3
        }
    }

    assign section.rail to geometry.imported_bracket.region.frame_edge
    assign layup.skin to geometry.imported_bracket.region.outer_skin
    assign orientation.laminate_axes to geometry.imported_bracket.region.outer_skin

    let overload = 1.5 * input.service_load

    constraint fixed_support {
        fixed on geometry.imported_bracket.region.fixed_base
    }

    load service_force {
        force on input.pad = [0, -input.service_load, 0]
    }

    load_case service {
        include load.service_force
    }

    signal shock : acceleration over time {
        generated by function.makeBracket {
            arguments {
                peak = 30 g
                duration = 6 ms
            }
            sample from 0 s to 50 ms at 100 kHz
            interpolation = linear
            tolerance = 1e-5 g
        }
    }

    excitation base_z {
        base_acceleration {
            direction = global([0, 0, 1])
            signal = signal.shock
        }
    }
}

execution scalable {
    placement = auto
    backend = auto

    resources {
        workers = 1..64
        memory_per_worker <= 32 GiB
        accelerators = preferred
    }

    fanout {
        sweep_cases = auto
        frequency_samples = auto
    }

    cooperative {
        operator_partitions = auto
        partitioner = graph
        balance = nonzeros
    }

    resilience {
        retries = 2
        checkpoint = automatic
    }
}

study bracket_response {
    input service_load : force {
        default = 1 kN
        minimum = 0 N
        maximum = 5 kN
    }
    geometry = geometry.imported_bracket
    mesh = mesh.bracket_mesh
    model = model.bracket(
        body_material = material.steel,
        service_load = input.service_load,
        body = geometry.imported_bracket.region.body,
        pad = geometry.imported_bracket.region.fixed_base,
    )
    execution = execution.scalable

    analysis modes {
        structural modal {
            constraints = [model.constraint.fixed_support]
            modes = 20
        }
        retain basis
    }

    analysis response after analysis.modes {
        structural modal_transient {
            basis = analysis.modes.state.basis
            excitations = [model.excitation.base_z]
        }
    }

    output displacement = analysis.response.field.node.displacement
    output peak_displacement = max(
        magnitude(output.displacement),
        over = geometry.imported_bracket.region.body,
    )
    output metadata = { label = "response", enabled = true }
}

sweep service_envelope over study.bracket_response {
    axis service_load {
        half_load = 0.5 kN
        nominal = 1.0 kN
        overload = 1.5 kN
    }

    case qualification {
        service_load = 1.25 kN
    }

    combine = product
    output stress_by_case = collect case.output.peak_stress.value
    output governing_case = max(case.output.peak_stress.value, over = cases)
    output stress_fields = retain_each case.output.stress
}
