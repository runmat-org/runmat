<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<!-- A hand-written test fixture: a header, a resistor and an LED. Written for RunMat's tests from the public format description; no third-party content. -->
<eagle version="9.6.2">
<drawing>
<settings><setting alwaysvectorfont="no"/></settings>
<grid distance="0.1" unitdist="inch" unit="inch"/>
<layers>
<layer number="1" name="Top" color="4" fill="1" visible="yes" active="yes"/>
<layer number="16" name="Bottom" color="1" fill="1" visible="yes" active="yes"/>
<layer number="20" name="Dimension" color="24" fill="1" visible="yes" active="yes"/>
<layer number="21" name="tPlace" color="7" fill="1" visible="yes" active="yes"/>
</layers>
<board>
<plain>
<wire x1="0" y1="0" x2="20" y2="0" width="0" layer="20"/>
<wire x1="20" y1="0" x2="20" y2="15" width="0" layer="20"/>
<wire x1="20" y1="15" x2="0" y2="15" width="0" layer="20"/>
<wire x1="0" y1="15" x2="0" y2="0" width="0" layer="20"/>
</plain>
<libraries>
<library name="passives">
<packages>
<package name="0603">
<description>Chip resistor, 0603</description>
<smd name="1" x="-0.8" y="0" dx="0.9" dy="0.95" layer="1"/>
<smd name="2" x="0.8" y="0" dx="0.9" dy="0.95" layer="1"/>
<wire x1="-1.5" y1="0.7" x2="1.5" y2="0.7" width="0.12" layer="21"/>
<wire x1="-1.5" y1="-0.7" x2="1.5" y2="-0.7" width="0.12" layer="21"/>
<text x="0" y="1.2" size="0.8" layer="25">&gt;NAME</text>
</package>
</packages>
<symbols>
<symbol name="R">
<pin name="1" x="-5.08" y="0" length="short" direction="pas"/>
<pin name="2" x="5.08" y="0" length="short" direction="pas" rot="R180"/>
</symbol>
</symbols>
<devicesets>
<deviceset name="R" prefix="R">
<description>&lt;b&gt;Resistor&lt;/b&gt; thick film</description>
<gates><gate name="G$1" symbol="R" x="0" y="0"/></gates>
<devices>
<device name="0603" package="0603">
<connects><connect gate="G$1" pin="1" pad="1"/><connect gate="G$1" pin="2" pad="2"/></connects>
<technologies><technology name=""/></technologies>
</device>
</devices>
</deviceset>
</devicesets>
</library>
<library name="leds">
<packages>
<package name="LED0603">
<smd name="A" x="-0.8" y="0" dx="0.9" dy="0.95" layer="1"/>
<smd name="C" x="0.8" y="0" dx="0.9" dy="0.95" layer="1" roundness="50"/>
<circle x="-1.6" y="0" radius="0.15" width="0" layer="21"/>
</package>
</packages>
<symbols>
<symbol name="LED">
<pin name="A" x="-5.08" y="0" length="short" direction="pas"/>
<pin name="C" x="5.08" y="0" length="short" direction="pas" rot="R180"/>
</symbol>
</symbols>
<devicesets>
<deviceset name="LED" prefix="D">
<gates><gate name="G$1" symbol="LED" x="0" y="0"/></gates>
<devices>
<device name="0603" package="LED0603">
<connects><connect gate="G$1" pin="A" pad="A"/><connect gate="G$1" pin="C" pad="C"/></connects>
<technologies><technology name="RED"><attribute name="MPN" value="LED-RED-0603"/><attribute name="COLOR" value="red"/></technology></technologies>
</device>
</devices>
</deviceset>
</devicesets>
</library>
<library name="connectors">
<packages>
<package name="HDR2">
<pad name="1" x="-1.27" y="0" drill="1" diameter="1.7" shape="square"/>
<pad name="2" x="1.27" y="0" drill="1"/>
<wire x1="-2.54" y1="1.27" x2="2.54" y2="1.27" width="0.15" layer="21"/>
</package>
</packages>
<symbols>
<symbol name="HDR2">
<pin name="1" x="-7.62" y="0" length="middle"/>
<pin name="2" x="-7.62" y="-2.54" length="middle"/>
</symbol>
</symbols>
<devicesets>
<deviceset name="HDR2" prefix="J">
<gates><gate name="G$1" symbol="HDR2" x="0" y="0"/></gates>
<devices>
<device name="" package="HDR2">
<connects><connect gate="G$1" pin="1" pad="1"/><connect gate="G$1" pin="2" pad="2"/></connects>
<technologies><technology name=""><attribute name="MPN" value="HDR-1X2-2.54"/></technology></technologies>
</device>
</devices>
</deviceset>
</devicesets>
</library>
</libraries>
<designrules name="example">
<param name="mdWireWire" value="6mil"/>
<param name="msWidth" value="6mil"/>
<param name="msDrill" value="0.3mm"/>
<param name="rlMinViaOuter" value="4mil"/>
<param name="mdCopperDimension" value="0.3mm"/>
</designrules>
<elements>
<element name="J1" library="connectors" package="HDR2" value="" x="4" y="7.5"/>
<element name="R1" library="passives" package="0603" value="1k" x="10" y="10"/>
<element name="D1" library="leds" package="LED0603" value="red" x="10" y="5" rot="MR180"/>
</elements>
<signals>
<signal name="VCC" class="1">
<contactref element="J1" pad="1"/><contactref element="R1" pad="1"/>
<wire x1="2.73" y1="7.5" x2="2.73" y2="10" width="0.4" layer="1"/><wire x1="2.73" y1="10" x2="9.2" y2="10" width="0.4" layer="1"/>
</signal>
<signal name="N$1">
<contactref element="R1" pad="2"/><contactref element="D1" pad="A"/>
<wire x1="10.8" y1="10" x2="12" y2="10" width="0.25" layer="1"/><wire x1="12" y1="10" x2="12" y2="7" width="0.25" layer="1"/><via x="12" y="7" extent="1-16" drill="0.3" diameter="0.6"/><wire x1="12" y1="7" x2="9.2" y2="7" width="0.25" layer="16"/><wire x1="9.2" y1="7" x2="9.2" y2="5" width="0.25" layer="16"/>
</signal>
<signal name="GND">
<contactref element="D1" pad="C"/><contactref element="J1" pad="2"/>
<wire x1="10.8" y1="5" x2="10.8" y2="3" width="0.25" layer="16"/><wire x1="10.8" y1="3" x2="5.27" y2="3" width="0.25" layer="16"/><wire x1="5.27" y1="3" x2="5.27" y2="7.5" width="0.25" layer="16"/>
<polygon width="0.3" layer="16" isolate="0.3"><vertex x="1" y="1"/><vertex x="19" y="1"/><vertex x="19" y="2.2"/><vertex x="1" y="2.2"/></polygon>
</signal>
</signals>
</board>
</drawing>
</eagle>
