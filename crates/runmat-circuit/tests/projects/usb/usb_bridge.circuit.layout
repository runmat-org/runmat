runmat 0.7
std 1

use circuit usb_bridge

layout usb_bridge {
    stackup rigid {
        finish = ENIG
        layer "F.Mask" = { kind = mask, thickness = 0.02, material = solder_mask }
        layer "F.Cu" = { kind = copper, thickness = 0.03479, weight = 1, material = copper }
        layer "dielectric 1" = { kind = core, thickness = 1.49042, material = fr4 }
        layer "B.Cu" = { kind = copper, thickness = 0.03479, weight = 1, material = copper }
        layer "B.Mask" = { kind = mask, thickness = 0.02, material = solder_mask }
    }
    outline = [[-15, -10], [15, -10], [15, 10], [-15, 10]]
    limits = { capability = advanced }
    net_class supply = { track_width = 0.25 mm, clearance = 0.1 mm }
    net VBUS : supply
    net GND : supply
    net "+3V3" : supply
    net VCAP
    net USB_DN
    net USB_DP
    net NRST
    net BOOT0
