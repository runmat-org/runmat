runmat 0.7
std 1

use circuit daq from "./daq.circuit"

layout daq {
    stackup rigid {
        finish = ENIG
        layer "F.Mask" = { kind = mask, thickness = 0.02, material = solder_mask }
        layer "F.Cu" = { kind = copper, thickness = 0.03479, weight = 1, material = copper }
        layer "dielectric 1" = { kind = prepreg, thickness = 0.284168, material = { name = "FR-4 prepreg", dk = 4.1, df = 0.02, conductivity = 0, k_inplane = 0.8, k_through = 0.3, density = 1850, cp = 1100, cte_ppm = 14 } }
        layer "In1.Cu" = { kind = copper, thickness = 0.017395, weight = 0.5, material = copper }
        layer "dielectric 2" = { kind = core, thickness = 0.284168, material = fr4 }
        layer "In2.Cu" = { kind = copper, thickness = 0.017395, weight = 0.5, material = copper }
        layer "dielectric 3" = { kind = prepreg, thickness = 0.284168, material = { name = "FR-4 prepreg", dk = 4.1, df = 0.02, conductivity = 0, k_inplane = 0.8, k_through = 0.3, density = 1850, cp = 1100, cte_ppm = 14 } }
        layer "In3.Cu" = { kind = copper, thickness = 0.017395, weight = 0.5, material = copper }
        layer "dielectric 4" = { kind = core, thickness = 0.284168, material = fr4 }
        layer "In4.Cu" = { kind = copper, thickness = 0.017395, weight = 0.5, material = copper }
        layer "dielectric 5" = { kind = prepreg, thickness = 0.284168, material = { name = "FR-4 prepreg", dk = 4.1, df = 0.02, conductivity = 0, k_inplane = 0.8, k_through = 0.3, density = 1850, cp = 1100, cte_ppm = 14 } }
        layer "B.Cu" = { kind = copper, thickness = 0.03479, weight = 1, material = copper }
        layer "B.Mask" = { kind = mask, thickness = 0.02, material = solder_mask }
    }
    outline = [[2, 0], [88, 0], [90, 2], [90, 58], [88, 60], [2, 60], [0, 58], [0, 2]]
    limits = { clearance = 0.15, track = 0.15, via_diameter = 0.45, drill = 0.2, annular = 0.1, hole_to_hole = 0.25, copper_to_edge = 0.3, silk_to_pad = 0.1, microvia_drill = 0.1 }
    net_class analog = { track_width = 0.2 mm, clearance = 0.2 mm }
    net_class power = { track_width = 0.4 mm, clearance = 0.2 mm }
    net "+5V" : power
    net GND : power
    net "+3V3" : power
    net "/ch[0]/INF" : analog
    net "/ch[0]/AIN" : analog
    net VREF : power
    net "/ch[1]/INF" : analog
    net "/ch[1]/AIN" : analog
    net "/ch[2]/INF" : analog
    net "/ch[2]/AIN" : analog
    net SS1
    net "+1V2" : power
    net SS2
    net NR
    net LED
    net PG1
    net CC1
    net CC2
    net AIN0
    net AIN1
    net AIN2
    net SW1
    net SW2
    net "/ch[0]/FB" : analog
    net "/ch[0]/AMP" : analog
    net "/ch[1]/FB" : analog
    net "/ch[1]/AMP" : analog
    net "/ch[2]/FB" : analog
    net "/ch[2]/AMP" : analog
    net FB1
    net FB2
    net CONVST
    net SCLK
    net SDO0
    net SDO1
    net SDO2
    room "ch[0]" = { outline = [[9, 41], [37, 41], [37, 55], [9, 55]], members = [C1, C2, C3, C4, C5, C6, R1, R2, R3, R4, U5, U6] }
    room "ch[1]" = { outline = [[9, 23], [37, 23], [37, 37], [9, 37]], members = [C7, C8, C9, C10, C11, C12, R5, R6, R7, R8, U7, U8] }
    room "ch[2]" = { outline = [[9, 5], [37, 5], [37, 19], [9, 19]], members = [C13, C14, C15, C16, C17, C18, R9, R10, R11, R12, U9, U10] }
