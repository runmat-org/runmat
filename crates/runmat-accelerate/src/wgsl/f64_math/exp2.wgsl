fn runmat_math64_exp2_table_value(index: u32) -> f64 {
    let words = runmat_math64_exp2_table[index];
    return runmat_f64_from_words(words.x, words.y);
}
// Gal/Bachelis reduction and minimax kernel, unchanged from libm exp2.rs.
// Exception flags and host x87 dispatch omitted. Coefficients and tables exact.
fn runmat_math64_exp2(x: f64) -> f64 {
    let redux = runmat_f64_from_words(0u, 0x43380000u) / f64(256.0);
    let p1 = runmat_f64_from_words(0xfefa39efu, 0x3fe62e42u);
    let p2 = runmat_f64_from_words(0xff82c575u, 0x3fcebfbdu);
    let p3 = runmat_f64_from_words(0xd704a0a6u, 0x3fac6b08u);
    let p4 = runmat_f64_from_words(0x88f70400u, 0x3f83b2abu);
    let p5 = runmat_f64_from_words(0x03875c74u, 0x3f55d880u);
    let bits = bitcast<u64>(x);
    let high = runmat_f64_high(x);
    let magnitude = high & 0x7fffffffu;
    if magnitude >= 0x7ff00000u {
        if magnitude > 0x7ff00000u || runmat_f64_low(x) != 0u { return x; }
        if high >> 31u != 0u { return f64(0.0); }
        return x;
    }
    if x >= f64(1024.0) { return runmat_f64_from_words(0u, 0x7ff00000u); }
    if x <= f64(-1075.0) { return f64(0.0); }
    if magnitude < 0x3c900000u { return f64(1.0) + x; }
    let reduced_bits = bitcast<u64>(x + redux);
    var i0 = u32(reduced_bits);
    i0 = i0 + 128u;
    let ku = i0 / 256u * 256u;
    let ki = bitcast<i32>(ku) / 256;
    i0 = i0 % 256u;
    let uf = bitcast<f64>(reduced_bits) - redux;
    var z = x - uf;
    let t = runmat_math64_exp2_table_value(2u * i0);
    z = z - runmat_math64_exp2_table_value(2u * i0 + 1u);
    let r = t + t * z * (p1 + z * (p2 + z * (p3 + z * (p4 + z * p5))));
    return runmat_math64_scalbn(r, ki);
}
